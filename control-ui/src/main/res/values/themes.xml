<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Motyw okna aktywności :control-ui: bez paska akcji, tło jak thumbcast_bg (D1). Treść i kolory rysuje
        ThumbcastTheme (Compose); paski systemowe ustawia enableEdgeToEdge w aktywności.
    -->
    <color name="ui_window_background">#0F1115</color>

    <style name="Theme.ThumbcastUi" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ui_window_background</item>
        <item name="android:colorBackground">@color/ui_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
