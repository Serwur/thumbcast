<?xml version="1.0" encoding="utf-8"?>
<!-- THUMBCAST: pasek nad listą ustawień i nad ekranem „Zaawansowane” (StreamSettings, nagłówek ListView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/thumbcast_list_item_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/thumbcast_space_xsmall"
    android:paddingEnd="@dimen/thumbcast_space_medium">

    <ImageButton
        android:id="@+id/thumbcast_settings_header_back"
        style="@style/ThumbcastIconButton"
        android:contentDescription="@string/thumbcast_common_navigate_up"
        android:src="@drawable/thumbcast_ic_arrow_back" />

    <TextView
        android:id="@+id/thumbcast_settings_header_title"
        style="@style/ThumbcastText.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/thumbcast_space_small"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        tools:targetApi="28"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
