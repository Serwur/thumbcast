<?xml version="1.0" encoding="utf-8"?>
<!--
    THUMBCAST (P2, U15): kafelek gry = app_grid_item.xml upstreamu + widoczny przycisk ⋮ (to samo menu co długie
    przytrzymanie: Ustawienia gry, ukrywanie, skrót). AppGridAdapter wybiera ten układ w bloku THUMBCAST.
    Identyfikatory grid_image, grid_overlay, grid_text bez zmian (AppView szuka grid_image przy tworzeniu skrótu).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="200dp"
    android:padding="10dp">
    <ImageView
        android:id="@+id/grid_image"
        android:importantForAccessibility="no"
        android:cropToPadding="false"
        android:scaleType="fitXY"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </ImageView>
    <ImageView
        android:id="@+id/grid_overlay"
        android:importantForAccessibility="no"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_width="50dp"
        android:layout_height="50dp">
    </ImageView>
    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/grid_overlay"
        android:layout_margin="5dp"
        android:gravity="center"
        android:textSize="18sp">
    </TextView>
    <ImageButton
        android:id="@+id/thumbcast_app_more"
        android:layout_width="@dimen/thumbcast_touch_target"
        android:layout_height="@dimen/thumbcast_touch_target"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/thumbcast_bg_pc_more"
        android:contentDescription="@string/thumbcast_common_more_options"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/thumbcast_ic_more_vert"
        android:tint="@color/thumbcast_text" />
</RelativeLayout>
