<?xml version="1.0" encoding="utf-8"?>
<!--
    THUMBCAST (P2, U9): siatka kart PC zamiast pc_grid_view.xml (PcView.getAdapterFragmentLayoutId, blok THUMBCAST).
    Identyfikator fragmentView zostaje (AdapterFragment). Karty mają własne tło z falą dotyku, więc selektor listy
    rysuje tylko obrys fokusu (pad, pilot, klawiatura).
-->
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:numColumns="auto_fit"
    android:columnWidth="156dp"
    android:stretchMode="columnWidth"
    android:horizontalSpacing="12dp"
    android:verticalSpacing="12dp"
    android:paddingStart="@dimen/thumbcast_space_medium"
    android:paddingEnd="@dimen/thumbcast_space_medium"
    android:paddingTop="@dimen/thumbcast_space_small"
    android:paddingBottom="@dimen/thumbcast_space_medium"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@+id/settingsButton"
    android:clipToPadding="false"
    android:listSelector="@drawable/thumbcast_bg_pc_grid_selector"
    android:drawSelectorOnTop="true"
    android:scrollbarStyle="outsideOverlay" />
