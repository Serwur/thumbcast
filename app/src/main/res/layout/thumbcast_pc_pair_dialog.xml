<?xml version="1.0" encoding="utf-8"?>
<!--
    THUMBCAST (P2, U10): treść dialogu parowania (ThumbcastPairingDialog): ponumerowane kroki w Sunshine, duży kod PIN
    czcionką o stałej szerokości i stan „Czekam…”. Tytuł i przyciski ustawia AlertDialog.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/thumbcast_space_large"
        android:paddingEnd="@dimen/thumbcast_space_large"
        android:paddingTop="@dimen/thumbcast_space_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/ThumbcastText.Badge.Accent"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/thumbcast_launcher_step_1" />

            <TextView
                style="@style/ThumbcastText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/thumbcast_space_medium"
                android:text="@string/thumbcast_launcher_pair_step_open" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/thumbcast_space_medium"
            android:orientation="horizontal">

            <TextView
                style="@style/ThumbcastText.Badge.Accent"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/thumbcast_launcher_step_2" />

            <TextView
                style="@style/ThumbcastText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/thumbcast_space_medium"
                android:text="@string/thumbcast_launcher_pair_step_tab" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/thumbcast_space_medium"
            android:orientation="horizontal">

            <TextView
                style="@style/ThumbcastText.Badge.Accent"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/thumbcast_launcher_step_3" />

            <TextView
                style="@style/ThumbcastText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/thumbcast_space_medium"
                android:text="@string/thumbcast_launcher_pair_step_enter" />
        </LinearLayout>

        <TextView
            android:id="@+id/thumbcast_pair_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/thumbcast_space_large"
            android:background="@drawable/thumbcast_bg_card"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:paddingTop="@dimen/thumbcast_space_medium"
            android:paddingBottom="@dimen/thumbcast_space_medium"
            android:textColor="@color/thumbcast_accent"
            android:textIsSelectable="true"
            android:textSize="44sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/thumbcast_space_medium"
            android:layout_marginBottom="@dimen/thumbcast_space_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:layout_width="@dimen/thumbcast_icon_size_small"
                android:layout_height="@dimen/thumbcast_icon_size_small"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:indeterminateTint="@color/thumbcast_text_secondary" />

            <TextView
                style="@style/ThumbcastText.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/thumbcast_space_small"
                android:text="@string/thumbcast_launcher_pair_waiting" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
