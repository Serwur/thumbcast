    <!-- Controls -->
    <string name="thumbcast_set_profile_title">Control profile</string>
    <string name="thumbcast_set_hide_on_gamepad_title">Hide buttons when I play with a gamepad</string>
    <string name="thumbcast_set_hide_on_gamepad_summary">On-screen buttons disappear when you connect a gamepad. Gestures and the menu button stay.</string>
    <string name="thumbcast_set_button_size_title">Button size</string>
    <string name="thumbcast_set_vibration_title">Phone vibration</string>
    <string name="thumbcast_set_vibration_summary">The phone vibrates when the game sends gamepad rumble and no gamepad is connected</string>

    <!-- Picture -->
    <string name="thumbcast_set_resolution_title">Resolution</string>
    <string name="thumbcast_set_resolution_summary">Higher looks sharper but puts more load on the network and the phone</string>
    <string name="thumbcast_set_fps_title">Smoothness (FPS)</string>
    <string name="thumbcast_set_fps_summary">More frames per second means smoother motion</string>
    <string name="thumbcast_set_quality_title">Picture quality</string>
    <string name="thumbcast_set_quality_summary">Higher is sharper but needs faster Wi-Fi. If the picture stutters, lower it (bitrate in Mbps).</string>
    <string name="thumbcast_set_stretch_title">Stretch picture to fill the screen</string>
    <string name="thumbcast_set_stretch_summary">No black bars, but the picture may look slightly distorted</string>
    <string name="thumbcast_set_sops_title">Match the PC game to the phone</string>
    <string name="thumbcast_set_sops_summary">Sunshine receives the phone\'s resolution and FPS. Without it the PC will not change its screen resolution (optimize game settings, SOPS).</string>
    <string name="thumbcast_set_stats_title">Statistics</string>
    <string name="thumbcast_set_stats_summary">Show FPS and latency in a corner of the screen while playing</string>
    <string name="thumbcast_set_stats_detailed_title">Detailed statistics</string>
    <string name="thumbcast_set_stats_detailed_summary">Also resolution, decoder, network and frame times. Works when Statistics is on. Both switches are also in the in-game menu.</string>

