<?xml version="1.0" encoding="utf-8"?>
<!-- Przycisk obrysowany (pigułka, obrys widoczny na tle). Styl: ThumbcastButton.Outlined. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/thumbcast_corner_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/thumbcast_stroke" android:color="@color/thumbcast_outline_strong" />
            <corners android:radius="@dimen/thumbcast_corner_large" />
        </shape>
    </item>
</ripple>
