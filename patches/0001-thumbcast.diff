+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app, pakiet P2 „Ekran startowy”, docs/ui-audit.md U2, U3, U8, U9, U11, U13, U15).
+// Logika widoków ekranu startowego wywoływana z bloków THUMBCAST w PcView, AppView, PcGridAdapter, AppGridAdapter,
+// AddComputerManually i HelpLauncher, żeby zmiany w plikach upstreamu były jak najmniejsze:
+// - poradnik „Jak podłączyć PC” (:control-ui, UiContract.setupGuideIntent) zamiast wiki upstreamu;
+// - karta PC: plakietka stanu tekstem (kolor tylko jako drugi sygnał), ikona stanu, przycisk ⋮ = menu kontekstowe;
+// - pusty stan listy PC: wskaźnik wyszukiwania, po EMPTY_STATE_DELAY_MS karta „Nie widzę komputera”;
+// - menu kontekstowe: zmiana etykiet i kolejności istniejących pozycji (te same identyfikatory, ta sama obsługa).
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.view.Menu;
+import android.view.MenuItem;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import com.limelight.LimeLog;
+import com.limelight.R;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.limelight.nvstream.http.PairingManager;
+import com.limelight.preferences.AddComputerManually;
+
+import app.thumbcast.ui.UiContract;
+
+public final class ThumbcastLauncherUi {
+
+    /** Po tylu ms bez żadnego PC lista pokazuje kartę „Nie widzę komputera” (U3). */
+    public static final long EMPTY_STATE_DELAY_MS = 5000;
+
+    private ThumbcastLauncherUi() {
+    }
+
+    // ---------- poradnik (U2) ----------
+
+    /**
+     * Otwiera poradnik „Jak podłączyć PC” z :control-ui na podanej sekcji ({@code UiContract.SECTION_*}, null = od
+     * początku). Zwraca false, gdy aktywności nie da się uruchomić (wtedy wołający może użyć zapasowej drogi).
+     */
+    public static boolean openGuide(Context context, String section) {
+        try {
+            Intent intent = UiContract.setupGuideIntent(context, section);
+            if (!(context instanceof Activity)) {
+                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            }
+            context.startActivity(intent);
+            return true;
+        } catch (RuntimeException e) {
+            LimeLog.warning("Thumbcast: setup guide failed: " + e);
+            return false;
+        }
+    }
+
+    // ---------- paski ekranów ----------
+
+    /** Przycisk „Wróć” w pasku (AppView, AddComputerManually): zamyka aktywność. */
+    public static void bindBackButton(final Activity activity, int viewId) {
+        View back = activity.findViewById(viewId);
+        if (back != null) {
+            back.setOnClickListener(v -> activity.finish());
+        }
+    }
+
+    /** AddComputerManually (U13): „Wróć” i „Nadal nie widać PC?” (poradnik, sekcja „Nie działa?”). */
+    public static void bindAddComputerScreen(final Activity activity) {
+        bindBackButton(activity, R.id.thumbcast_add_pc_back);
+        View help = activity.findViewById(R.id.thumbcast_add_pc_help);
+        if (help != null) {
+            help.setOnClickListener(v -> openGuide(activity, UiContract.SECTION_TROUBLESHOOT));
+        }
+    }
+
+    // ---------- pusty stan listy PC (U3) ----------
+
+    /**
+     * Pusty stan listy PC w układzie thumbcast_activity_pc_view: najpierw wskaźnik „Szukam…”, po
+     * {@link #EMPTY_STATE_DELAY_MS} od utworzenia ekranu karta z podpowiedziami i przyciskami. Widoczność całego
+     * kontenera ({@code no_pc_found_layout}) dalej ustawia kod upstreamu. {@link #bind} woła się po każdym
+     * {@code setContentView} (także po obrocie), {@link #release} w {@code onDestroy}.
+     */
+    public static final class EmptyState {
+        private final Handler handler = new Handler(Looper.getMainLooper());
+        private final long createdAtMs = SystemClock.elapsedRealtime();
+        private final Runnable reveal = this::showCard;
+        private View searching;
+        private View card;
+
+        public void bind(final Activity activity) {
+            handler.removeCallbacks(reveal);
+            searching = activity.findViewById(R.id.thumbcast_pc_searching);
+            card = activity.findViewById(R.id.thumbcast_pc_empty_scroll);
+            if (searching == null || card == null) {
+                return;
+            }
+            View guide = activity.findViewById(R.id.thumbcast_pc_empty_guide);
+            guide.setOnClickListener(v -> openGuide(activity, UiContract.SECTION_INSTALL));
+            View add = activity.findViewById(R.id.thumbcast_pc_empty_add);
+            add.setOnClickListener(v -> activity.startActivity(new Intent(activity, AddComputerManually.class)));
+
+            long left = EMPTY_STATE_DELAY_MS - (SystemClock.elapsedRealtime() - createdAtMs);
+            if (left <= 0) {
+                showCard();
+            } else {
+                searching.setVisibility(View.VISIBLE);
+                card.setVisibility(View.GONE);
+                handler.postDelayed(reveal, left);
+            }
+        }
+
+        private void showCard() {
+            if (searching == null || card == null) {
+                return;
+            }
+            searching.setVisibility(View.GONE);
+            card.setVisibility(View.VISIBLE);
+        }
+
+        public void release() {
+            handler.removeCallbacks(reveal);
+            searching = null;
+            card = null;
+        }
+    }
+
+    // ---------- karta PC (U9) ----------
+
+    /** Tekst stanu PC jak na plakietce karty (też nagłówek menu PC). */
+    public static String statusText(Context context, ComputerDetails details) {
+        return context.getString(statusTextRes(details));
+    }
+
+    private static int statusTextRes(ComputerDetails d) {
+        if (d.state == ComputerDetails.State.OFFLINE) {
+            return R.string.thumbcast_launcher_status_offline;
+        }
+        if (d.state != ComputerDetails.State.ONLINE) {
+            return R.string.thumbcast_launcher_status_checking;
+        }
+        if (d.pairState == PairingManager.PairState.NOT_PAIRED) {
+            return R.string.thumbcast_launcher_status_unpaired;
+        }
+        if (d.runningGameId != 0) {
+            return R.string.thumbcast_launcher_status_in_game;
+        }
+        return R.string.thumbcast_launcher_status_online;
+    }
+
+    /**
+     * Wypełnia kartę PC (thumbcast_pc_grid_item). Zwraca false, gdy widok nie jest kartą Thumbcast (wtedy
+     * PcGridAdapter robi to po swojemu, jak upstream).
+     */
+    public static boolean populatePcCard(View root, ImageView image, ProgressBar spinner, TextView name,
+                                         ImageView overlay, ComputerDetails d) {
+        TextView status = root.findViewById(R.id.thumbcast_pc_status);
+        if (status == null) {
+            return false;
+        }
+        Context context = root.getContext();
+
+        int badgeBg;
+        int badgeColor;
+        int overlayIcon = 0;
+        int overlayColor = R.color.thumbcast_text_secondary;
+        float imageAlpha = 1.0f;
+        boolean checking = false;
+        if (d.state == ComputerDetails.State.OFFLINE) {
+            badgeBg = R.drawable.thumbcast_bg_pill_neutral;
+            badgeColor = R.color.thumbcast_text_secondary;
+            overlayIcon = R.drawable.thumbcast_ic_wifi_off;
+            imageAlpha = 0.5f;
+        } else if (d.state != ComputerDetails.State.ONLINE) {
+            badgeBg = R.drawable.thumbcast_bg_pill_neutral;
+            badgeColor = R.color.thumbcast_text_secondary;
+            imageAlpha = 0.5f;
+            checking = true;
+        } else if (d.pairState == PairingManager.PairState.NOT_PAIRED) {
+            badgeBg = R.drawable.thumbcast_bg_pill_warning;
+            badgeColor = R.color.thumbcast_warning;
+            overlayIcon = R.drawable.thumbcast_ic_lock;
+            overlayColor = R.color.thumbcast_warning;
+        } else if (d.runningGameId != 0) {
+            badgeBg = R.drawable.thumbcast_bg_pill_accent;
+            badgeColor = R.color.thumbcast_accent;
+            overlayIcon = R.drawable.thumbcast_ic_play_arrow;
+            overlayColor = R.color.thumbcast_accent;
+        } else {
+            badgeBg = R.drawable.thumbcast_bg_pill_success;
+            badgeColor = R.color.thumbcast_success;
+        }
+
+        String statusText = context.getString(statusTextRes(d));
+        image.setImageResource(R.drawable.thumbcast_ic_computer);
+        image.setAlpha(imageAlpha);
+        name.setText(d.name);
+        name.setAlpha(1.0f);
+        status.setText(statusText);
+        status.setBackgroundResource(badgeBg);
+        status.setTextColor(context.getColor(badgeColor));
+        if (spinner != null) {
+            spinner.setVisibility(checking ? View.VISIBLE : View.GONE);
+        }
+        if (overlay != null) {
+            if (overlayIcon != 0) {
+                overlay.setImageResource(overlayIcon);
+                overlay.setImageTintList(context.getColorStateList(overlayColor));
+                overlay.setAlpha(1.0f);
+                overlay.setVisibility(View.VISIBLE);
+            } else {
+                overlay.setVisibility(View.GONE);
+            }
+        }
+        root.setContentDescription(context.getString(R.string.thumbcast_launcher_card_description, d.name, statusText));
+        bindMoreButton(root.findViewById(R.id.thumbcast_pc_more), root,
+                context.getString(R.string.thumbcast_launcher_more_for, d.name));
+        return true;
+    }
+
+    /**
+     * Przycisk ⋮ na karcie PC lub kafelku gry: otwiera to samo menu kontekstowe co długie przytrzymanie (siatka
+     * tworzy {@code AdapterContextMenuInfo} dla elementu {@code itemRoot}). Bez fokusu, żeby siatka dalej
+     * dostawała tap w element i nawigację padem (ImageButton ustawia fokus w konstruktorze, więc także w kodzie).
+     */
+    public static void bindMoreButton(View more, final View itemRoot, String description) {
+        if (more == null) {
+            return;
+        }
+        more.setFocusable(false);
+        more.setContentDescription(description);
+        more.setTooltipText(description);
+        more.setOnClickListener(v -> itemRoot.showContextMenu());
+    }
+
+    // ---------- menu kontekstowe (U11, U15) ----------
+
+    /**
+     * Przenosi istniejącą pozycję menu (ten sam identyfikator, więc obsługa w onContextItemSelected bez zmian) na
+     * pozycję {@code order} w grupie {@code groupId} i zmienia jej etykietę. Pozycji, której nie ma, nie dodaje.
+     */
+    public static void place(Menu menu, int itemId, int groupId, int order, CharSequence title) {
+        MenuItem old = menu.findItem(itemId);
+        if (old == null) {
+            return;
+        }
+        boolean checkable = old.isCheckable();
+        boolean checked = old.isChecked();
+        menu.removeItem(itemId);
+        MenuItem item = menu.add(groupId, itemId, order, title);
+        item.setCheckable(checkable);
+        item.setChecked(checked);
+    }
+
+    /** Linie między grupami menu (diagnostyka, usuwanie); API 28+, wcześniej menu bez linii. */
+    public static void enableGroupDividers(Menu menu) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            menu.setGroupDividerEnabled(true);
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuHintView.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuHintView.java
new file mode 100644
index 00000000..e44935ff
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuHintView.java
@@ -0,0 +1,148 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Jednorazowa podpowiedź przy starcie strumienia (G6, 12.11.2026): pigułka z ikoną menu
+// i tekstem „Menu: przycisk w rogu albo przeciągnij od góry”. Pokazuje ją ThumbcastSession po nawiązaniu połączenia,
+// gdy flaga w ThumbcastSettings jeszcze nie jest ustawiona; znika po ok. 4 s albo przy pierwszym otwarciu menu.
+// Czysty element UI: nie bierze dotyku ani fokusu, niczego nie wysyła do hosta (FAIR_PLAY: timer tylko chowa napis).
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Build;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.WindowInsets;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.limelight.R;
+
+import java.util.List;
+
+import app.thumbcast.android.overlay.PxRect;
+
+@SuppressLint("ViewConstructor")
+final class ThumbcastMenuHintView extends LinearLayout {
+
+    private static final int FADE_MS = 200;
+
+    private final float density;
+
+    ThumbcastMenuHintView(Context context) {
+        super(context);
+        density = getResources().getDisplayMetrics().density;
+        setOrientation(HORIZONTAL);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setPadding(dp(16), dp(10), dp(20), dp(10));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(context.getColor(R.color.thumbcast_menu_surface));
+        bg.setStroke(dp(1), context.getColor(R.color.thumbcast_divider));
+        bg.setCornerRadius(dp(24));
+        setBackground(bg);
+        setElevation(dp(4));
+
+        ImageView icon = new ImageView(context);
+        icon.setImageDrawable(context.getDrawable(R.drawable.thumbcast_ic_game_menu));
+        icon.setImageTintList(ColorStateList.valueOf(context.getColor(R.color.thumbcast_accent)));
+        icon.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        addView(icon, new LayoutParams(dp(20), dp(20)));
+
+        TextView text = new TextView(context);
+        text.setText(R.string.thumbcast_game_menu_hint);
+        text.setTextColor(context.getColor(R.color.thumbcast_text));
+        text.setTextSize(TypedValue.COMPLEX_UNIT_PX, getResources().getDimension(R.dimen.thumbcast_text_body_small));
+        LayoutParams tlp = new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT);
+        tlp.setMarginStart(dp(10));
+        addView(text, tlp);
+
+        setClickable(false);
+        setFocusable(View.NOT_FOCUSABLE);
+        // Komunikat dla TalkBack (raz, przy pokazaniu), bez fokusu i dotyku.
+        setAccessibilityLiveRegion(View.ACCESSIBILITY_LIVE_REGION_POLITE);
+    }
+
+    /** Parametry w rodzicu StreamView: rozmiar wg treści, położenie przez translację ({@link #place}). */
+    static FrameLayout.LayoutParams layoutParams() {
+        return new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.START);
+    }
+
+    /** Podpowiedź nigdy nie bierze dotyku: zdarzenie idzie dalej do overlaya i strumienia. */
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent event) {
+        return false;
+    }
+
+    @Override
+    public boolean dispatchGenericMotionEvent(MotionEvent event) {
+        return false;
+    }
+
+    /**
+     * Na środku w poziomie, możliwie wysoko (pod wcięciem), ale pod przyciskami, które leżą w tym miejscu
+     * ({@code obstacles} w px rodzica). Gdy w górnej połowie nie ma miejsca: pod górną krawędzią.
+     */
+    void place(List<PxRect> obstacles) {
+        View parent = (View) getParent();
+        if (parent == null || parent.getWidth() <= 0) {
+            return;
+        }
+        int pw = parent.getWidth();
+        int ph = parent.getHeight();
+        measure(MeasureSpec.makeMeasureSpec(Math.max(0, pw - dp(32)), MeasureSpec.AT_MOST),
+                MeasureSpec.makeMeasureSpec(ph, MeasureSpec.AT_MOST));
+        int w = getMeasuredWidth();
+        int h = getMeasuredHeight();
+        float x = (pw - w) / 2f;
+        float top = topInset(parent) + dp(16);
+        float y = top;
+        for (int guard = 0; guard < 16; guard++) {
+            float bottomOfHit = -1f;
+            for (PxRect r : obstacles) {
+                if (r.getLeft() < x + w && r.getRight() > x && r.getTop() < y + h && r.getBottom() > y) {
+                    bottomOfHit = Math.max(bottomOfHit, r.getBottom());
+                }
+            }
+            if (bottomOfHit < 0f) {
+                break;
+            }
+            y = bottomOfHit + dp(8);
+        }
+        if (y + h > ph / 2f) {
+            y = top;
+        }
+        setTranslationX(Math.round(x));
+        setTranslationY(Math.round(y));
+    }
+
+    void fadeIn() {
+        setAlpha(0f);
+        animate().alpha(1f).setDuration(FADE_MS).start();
+    }
+
+    @SuppressWarnings("deprecation")
+    private static int topInset(View parent) {
+        WindowInsets insets = parent.getRootWindowInsets();
+        if (insets == null) {
+            return 0;
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            return insets.getInsets(WindowInsets.Type.systemBars() | WindowInsets.Type.displayCutout()).top;
+        }
+        int t = insets.getSystemWindowInsetTop();
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P && insets.getDisplayCutout() != null) {
+            t = Math.max(t, insets.getDisplayCutout().getSafeInsetTop());
+        }
+        return t;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * density);
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuModel.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuModel.java
new file mode 100644
index 00000000..755f3b0e
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastMenuModel.java
@@ -0,0 +1,447 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Strony menu w grze (pozycje, sekcje, ikony i akcje) bez widoku: ThumbcastMenuView je tylko
+// rysuje, ThumbcastSession dostarcza stan i wykonuje akcje.
+//
+// Od 12.11.2026 (przebudowa UI, pakiet P4, docs/ui-audit.md G1–G17) strona główna ma układ:
+//   „Wróć do gry” (wypełniony przycisk, domyślne zaznaczenie z pada)
+//   szybkie akcje: Klawiatura, Ukryj/Pokaż przyciski (kafle)
+//   Sterowanie: Profil sterowania (→ strona profili), Gesty myszy (przełącznik + podpis zależny od profilu),
+//               Rozmiar przycisków (− wartość +), Chowaj przyciski, gdy gram padem (przełącznik)
+//   Obraz:      Statystyki (Wył. / Podstawowe / Szczegółowe; zapis bez zmian: dwie flagi StatsToggles)
+//   Wyjście:    Wstrzymaj i wyjdź (rozłączenie, gra działa dalej), Zamknij grę na PC (→ potwierdzenie, /cancel)
+// Strona profili: sekcje „Wbudowane” i „Moje”, aktywny z ikoną check, domyślny z gwiazdką.
+// Potwierdzenie: ikona ostrzeżenia, tytuł i akapit (Page.intro*), „Anuluj” (domyślne zaznaczenie), „Zamknij grę”.
+
+import com.limelight.R;
+
+import app.thumbcast.android.stats.StatsMode;
+import app.thumbcast.android.stats.StatsToggles;
+import app.thumbcast.model.MouseGesturesTransform;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+final class ThumbcastMenuModel {
+
+    /** Teksty z zasobów (Context.getString), żeby model nie zależał od widoku. */
+    interface Strings {
+        String get(int resId, Object... formatArgs);
+    }
+
+    /** Stan i akcje sesji, które menu pokazuje i wywołuje. */
+    interface Target {
+        /** „Wstrzymaj i wyjdź”: strumień zatrzymany, aplikacja na PC działa dalej (wznowienie z listy). */
+        void disconnect();
+
+        /** Strona potwierdzenia „Zamknij grę na PC” (menu zostaje otwarte). */
+        void openEndSession();
+
+        /** „Zamknij grę”: strumień zatrzymany, potem aplikacja na PC zamknięta (/cancel; wołane po zamknięciu menu). */
+        void endSession();
+
+        /** Stan nakładki statystyk (zapisany globalnie). */
+        StatsToggles getStatsToggles();
+
+        /** Zmiana na żywo i zapis (menu zostaje otwarte). */
+        void setStatsToggles(StatsToggles toggles);
+
+        boolean areControlsHidden();
+
+        void toggleControls();
+
+        /** Klawiatura ekranowa; wołane po zamknięciu menu. */
+        void toggleKeyboard();
+
+        int getScalePercent();
+
+        /** Zmiana na żywo (overlay przelicza układ, menu zostaje otwarte). */
+        void setScalePercent(int percent);
+
+        boolean isHideOnGamepad();
+
+        void setHideOnGamepad(boolean hide);
+
+        /** Nazwa wyświetlana aktywnego profilu. */
+        String getActiveProfileName();
+
+        /** Strona z listą profili (menu zostaje otwarte). */
+        void openProfiles();
+
+        /** Powrót z podstrony na stronę główną. */
+        void showMainPage();
+
+        /** Zmiana aktywnego profilu na żywo (wołane po zamknięciu menu); aktywny profil = nic. */
+        void switchProfile(String fileName);
+
+        /** Przełącznik „Gesty myszy” aktywnego profilu (stan efektywny). */
+        boolean isMouseGestures();
+
+        /** Rodzaj gestów aktywnego profilu (podpis pod przełącznikiem). */
+        MouseGesturesTransform.Style getMouseGesturesStyle();
+
+        /** Zmiana na żywo i zapis dla pliku aktywnego profilu (menu zostaje otwarte). */
+        void setMouseGestures(boolean enabled);
+    }
+
+    /**
+     * Profil na stronie wyboru: plik (wartość preferencji list_thumbcast_profile) i nazwa; {@code active} = profil
+     * tej sesji, {@code isDefault} = profil domyślny (preferencja), może być inny przy profilu aplikacji;
+     * {@code builtIn} = preset dostarczony z aplikacją (sekcja „Wbudowane”).
+     */
+    static final class ProfileChoice {
+        final String fileName;
+        final String name;
+        final boolean active;
+        final boolean isDefault;
+        final boolean builtIn;
+
+        ProfileChoice(String fileName, String name, boolean active, boolean isDefault, boolean builtIn) {
+            this.fileName = fileName;
+            this.name = name;
+            this.active = active;
+            this.isDefault = isDefault;
+            this.builtIn = builtIn;
+        }
+    }
+
+    /** Rodzaj wiersza: wygląd i to, co robią A, lewo i prawo z pada. */
+    enum Kind {
+        /** Wypełniony przycisk w akcencie (Wróć do gry). */
+        PRIMARY,
+        /** Przycisk z obrysem (Anuluj). */
+        SECONDARY,
+        /** Wypełniony przycisk w kolorze błędu (Zamknij grę). */
+        DANGER,
+        /** Kafel szybkiej akcji; kolejne kafle leżą w jednym rzędzie, lewo/prawo przechodzi między nimi. */
+        TILE,
+        /** Wiersz z ikoną, tytułem i opcjonalnym podpisem; {@link Item#danger} = kolor błędu. */
+        ROW,
+        /** Wiersz prowadzący na podstronę (wartość w podpisie, strzałka). */
+        NAV,
+        /** Przełącznik: A przełącza, lewo = wył., prawo = wł. */
+        SWITCH,
+        /** Wartość z przyciskami − / +: lewo/prawo zmienia. */
+        STEPPER,
+        /** Jedna z kilku opcji: lewo/prawo wybiera sąsiednią, A następną (z zawijaniem). */
+        SEGMENTED,
+        /** Profil na stronie profili ({@link Item#selected} = aktywny, {@link Item#starred} = domyślny). */
+        CHOICE
+    }
+
+    /** Wybór opcji wiersza SEGMENTED. */
+    interface OptionSelector {
+        void select(int index);
+    }
+
+    static final class Item {
+        final Kind kind;
+        /** Sekcja (nagłówek nad pierwszym wierszem sekcji); null = bez sekcji (góra strony). */
+        final String section;
+        final int icon;
+        final String title;
+        /** Podpis pod tytułem (NAV: wartość); null = brak. */
+        final String subtitle;
+        /** ROW: kolor błędu (akcja nieodwracalna). */
+        final boolean danger;
+        /** true = najpierw zamknij menu, potem akcja; false = menu zostaje i odświeża wiersze. */
+        final boolean closesMenu;
+        /** Wiersz zaznaczany jako pierwszy przy nawigacji padem. */
+        final boolean defaultFocus;
+        /** Akcja (A, dotyk); SWITCH: przełączenie. */
+        final Runnable action;
+        /** SWITCH: stan; CHOICE: aktywny. */
+        final boolean checked;
+        /** CHOICE: profil domyślny (gwiazdka). */
+        final boolean starred;
+        /** STEPPER: wartość w pigułce; krok w dół / w górę, null = koniec zakresu. */
+        final String value;
+        final Runnable decrease;
+        final Runnable increase;
+        final String decreaseDescription;
+        final String increaseDescription;
+        /** SEGMENTED: opcje, wybrana i wybór. */
+        final String[] options;
+        final int selectedOption;
+        final OptionSelector selector;
+
+        private Item(Builder b) {
+            kind = b.kind;
+            section = b.section;
+            icon = b.icon;
+            title = b.title;
+            subtitle = b.subtitle;
+            danger = b.danger;
+            closesMenu = b.closesMenu;
+            defaultFocus = b.defaultFocus;
+            action = b.action;
+            checked = b.checked;
+            starred = b.starred;
+            value = b.value;
+            decrease = b.decrease;
+            increase = b.increase;
+            decreaseDescription = b.decreaseDescription;
+            increaseDescription = b.increaseDescription;
+            options = b.options;
+            selectedOption = b.selectedOption;
+            selector = b.selector;
+        }
+    }
+
+    /** Budowanie wierszy: tylko w tym pliku. */
+    private static final class Builder {
+        final Kind kind;
+        final String title;
+        String section;
+        int icon;
+        String subtitle;
+        boolean danger;
