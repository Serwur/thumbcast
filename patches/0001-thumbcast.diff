+
+    // ---------- eksport i udostępnianie ----------
+
+    private void startExport(ProfileEntry entry) {
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT)
+                .addCategory(Intent.CATEGORY_OPENABLE)
+                .setType(ProfileRepository.MIME_TYPE)
+                .putExtra(Intent.EXTRA_TITLE, ProfileRepository.suggestedFileName(entry.getName()));
+        try {
+            pendingExportFile = entry.getFileName();
+            startActivityForResult(intent, REQ_EXPORT);
+        } catch (ActivityNotFoundException e) {
+            pendingExportFile = null;
+            Toast.makeText(this, R.string.thumbcast_library_no_file_picker, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void writeExport(final String fileName, final Uri uri) {
+        final String text;
+        try {
+            text = repo.exportText(fileName);
+        } catch (ProfileLibraryException e) {
+            showError(R.string.thumbcast_library_error, e);
+            return;
+        }
+        io.execute(() -> {
+            String error = null;
+            try (OutputStream out = openForWrite(uri)) {
+                if (out == null) {
+                    throw new IOException("null stream");
+                }
+                out.write(text.getBytes(StandardCharsets.UTF_8));
+            } catch (IOException | SecurityException e) {
+                error = e.getMessage() != null ? e.getMessage() : e.toString();
+            }
+            final String finalError = error;
+            runOnUiThread(() -> {
+                if (isFinishing() || isDestroyed()) {
+                    return;
+                }
+                if (finalError == null) {
+                    Toast.makeText(this, R.string.thumbcast_library_exported, Toast.LENGTH_SHORT).show();
+                } else {
+                    Toast.makeText(this, getString(R.string.thumbcast_library_export_failed, finalError),
+                            Toast.LENGTH_LONG).show();
+                }
+            });
+        });
+    }
+
+    private OutputStream openForWrite(Uri uri) throws IOException {
+        try {
+            // "wt" obcina istniejący plik; nie każdy dostawca go obsługuje.
+            return getContentResolver().openOutputStream(uri, "wt");
+        } catch (IllegalArgumentException | IOException e) {
+            return getContentResolver().openOutputStream(uri, "w");
+        }
+    }
+
+    private void share(ProfileEntry entry) {
+        try {
+            String text = repo.exportText(entry.getFileName());
+            String name = ProfileRepository.suggestedFileName(entry.getName());
+            Uri uri = ProfileShareProvider.writeShareFile(this, name, text);
+            Intent send = new Intent(Intent.ACTION_SEND)
+                    .setType(ProfileRepository.MIME_TYPE)
+                    .putExtra(Intent.EXTRA_STREAM, uri)
+                    .putExtra(Intent.EXTRA_SUBJECT, entry.getName())
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            send.setClipData(ClipData.newRawUri(name, uri));
+            startActivity(Intent.createChooser(send, getString(R.string.thumbcast_library_share_title)));
+        } catch (ProfileLibraryException e) {
+            showError(R.string.thumbcast_library_error, e);
+        } catch (IOException | ActivityNotFoundException e) {
+            Toast.makeText(this, getString(R.string.thumbcast_library_export_failed, String.valueOf(e.getMessage())),
+                    Toast.LENGTH_LONG).show();
+        }
+    }
+
+    // ---------- import ----------
+
+    private void pickImportFile() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                .addCategory(Intent.CATEGORY_OPENABLE)
+                .setType("*/*")
+                .putExtra(Intent.EXTRA_MIME_TYPES,
+                        new String[]{ProfileRepository.MIME_TYPE, "application/octet-stream", "text/plain"});
+        try {
+            startActivityForResult(intent, REQ_IMPORT_FILE);
+        } catch (ActivityNotFoundException e) {
+            Toast.makeText(this, R.string.thumbcast_library_no_file_picker, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void importFromClipboard() {
+        ClipboardManager cm = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+        ClipData clip = cm != null ? cm.getPrimaryClip() : null;
+        CharSequence text = null;
+        if (clip != null && clip.getItemCount() > 0) {
+            text = clip.getItemAt(0).getText();
+        }
+        if (text == null || text.toString().trim().isEmpty()) {
+            Toast.makeText(this, R.string.thumbcast_library_clipboard_empty, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        importFromText(text.toString());
+    }
+
+    private void handleIncomingIntent(Intent intent) {
+        if (intent == null || intent.getAction() == null) {
+            return;
+        }
+        String action = intent.getAction();
+        if (Intent.ACTION_SEND.equals(action)) {
+            Uri stream = getStreamExtra(intent);
+            if (stream != null) {
+                importFromUri(stream);
+                return;
+            }
+            CharSequence text = intent.getCharSequenceExtra(Intent.EXTRA_TEXT);
+            if (text != null) {
+                importFromText(text.toString());
+            }
+        } else if (Intent.ACTION_VIEW.equals(action) && intent.getData() != null) {
+            importFromUri(intent.getData());
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private static Uri getStreamExtra(Intent intent) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            return intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri.class);
+        }
+        return intent.getParcelableExtra(Intent.EXTRA_STREAM);
+    }
+
+    private void importFromText(String text) {
+        try {
+            showImportConfirmation(repo.prepareImport(text));
+        } catch (ProfileLibraryException e) {
+            showError(R.string.thumbcast_library_import_failed, e);
+        }
+    }
+
+    private void importFromUri(final Uri uri) {
+        // Tylko content:// (SAF, udostępnianie). file:// mógłby wskazywać prywatne pliki aplikacji.
+        if (!"content".equals(uri.getScheme())) {
+            showErrorMessage(R.string.thumbcast_library_import_failed, getString(R.string.thumbcast_library_err_io));
+            return;
+        }
+        io.execute(() -> {
+            ImportPreview preview = null;
+            ProfileLibraryException failure = null;
+            String ioError = null;
+            try (InputStream in = getContentResolver().openInputStream(uri)) {
+                if (in == null) {
+                    throw new IOException("null stream");
+                }
+                preview = repo.prepareImport(ProfileRepository.readLimited(in));
+            } catch (ProfileLibraryException e) {
+                failure = e;
+            } catch (IOException | SecurityException | IllegalArgumentException e) {
+                ioError = e.getMessage() != null ? e.getMessage() : e.toString();
+            }
+            final ImportPreview p = preview;
+            final ProfileLibraryException f = failure;
+            final String ioMsg = ioError;
+            runOnUiThread(() -> {
+                if (isFinishing() || isDestroyed()) {
+                    return;
+                }
+                if (p != null) {
+                    showImportConfirmation(p);
+                } else if (f != null) {
+                    showError(R.string.thumbcast_library_import_failed, f);
+                } else {
+                    showErrorMessage(R.string.thumbcast_library_import_failed,
+                            getString(R.string.thumbcast_library_err_io) + "\n" + ioMsg);
+                }
+            });
+        });
+    }
+
+    private void showImportConfirmation(final ImportPreview preview) {
+        StringBuilder message = new StringBuilder(getString(R.string.thumbcast_library_import_details,
+                preview.getName(), preview.getControlCount(), modeLabel(preview.getMode())));
+        if (preview.getIdChanged()) {
+            message.append("\n\n").append(getString(R.string.thumbcast_library_import_new_id));
+        }
+        new AlertDialog.Builder(this)
+                .setTitle(R.string.thumbcast_library_import_title)
+                .setMessage(message)
+                .setPositiveButton(R.string.thumbcast_library_import_confirm, (d, w) -> commitImport(preview, false))
+                .setNeutralButton(R.string.thumbcast_library_import_confirm_use, (d, w) -> commitImport(preview, true))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void commitImport(ImportPreview preview, boolean use) {
+        try {
+            String file = repo.commitImport(preview);
+            if (use) {
+                selectFile(file);
+            } else {
+                refresh();
+            }
+            Toast.makeText(this, getString(R.string.thumbcast_library_imported, preview.getName()),
+                    Toast.LENGTH_SHORT).show();
+        } catch (ProfileLibraryException e) {
+            showError(R.string.thumbcast_library_import_failed, e);
+        }
+    }
+
+    // ---------- komunikaty ----------
+
+    private String modeLabel(ProfileMode mode) {
+        if (mode == null) {
+            return "?";
+        }
+        switch (mode) {
+            case KEYBOARD_MOUSE:
+                return getString(R.string.thumbcast_library_mode_keyboard_mouse);
+            case PAD_PLUS:
+            default:
+                return getString(R.string.thumbcast_library_mode_pad_plus);
+        }
+    }
+
+    private String reasonText(ProfileLibraryException e) {
+        switch (e.getReason()) {
+            case TOO_LARGE:
+                return getString(R.string.thumbcast_library_err_too_large, ProfileRepository.MAX_IMPORT_BYTES / 1024);
+            case NOT_UTF8:
+                return getString(R.string.thumbcast_library_err_not_utf8);
+            case INVALID_PROFILE: {
+                StringBuilder sb = new StringBuilder(getString(R.string.thumbcast_library_err_invalid));
+                List<String> details = e.getDetails();
+                for (int i = 0; i < details.size() && i < MAX_ERROR_LINES; i++) {
+                    sb.append("\n• ").append(details.get(i));
+                }
+                if (details.size() > MAX_ERROR_LINES) {
+                    sb.append("\n…");
+                }
+                return sb.toString();
+            }
+            case NOT_FOUND:
+                return getString(R.string.thumbcast_library_err_not_found);
+            case BUILT_IN_READ_ONLY:
+                return getString(R.string.thumbcast_library_err_read_only);
+            case INVALID_NAME:
+                return getString(R.string.thumbcast_library_err_name, ProfileRepository.MAX_NAME_LENGTH);
+            case INVALID_ID:
+                return getString(R.string.thumbcast_library_err_id);
+            case IO:
+            default:
+                return getString(R.string.thumbcast_library_err_io);
+        }
+    }
+
+    private void showError(int titleRes, ProfileLibraryException e) {
+        showErrorMessage(titleRes, reasonText(e));
+    }
+
+    private void showErrorMessage(int titleRes, String message) {
+        new AlertDialog.Builder(this)
+                .setTitle(titleRes)
+                .setMessage(message)
+                .setPositiveButton(android.R.string.ok, null)
+                .show();
+    }
+
+    // ---------- lista ----------
+
+    /** Ikona rodzaju profilu (ProfileKind, :control-android); uszkodzony plik = ostrzeżenie. */
+    private static int iconFor(ProfileKind kind) {
+        if (kind == null) {
+            return R.drawable.thumbcast_ic_warning;
+        }
+        switch (kind) {
+            case TOUCH:
+                return R.drawable.thumbcast_ic_touch_app;
+            case DESKTOP:
+                return R.drawable.thumbcast_ic_mouse;
+            case KEYBOARD:
+                return R.drawable.thumbcast_ic_keyboard;
+            case GAMEPAD_PLUS:
+                return R.drawable.thumbcast_ic_gamepad;
+            case GAMEPAD:
+            default:
+                return R.drawable.thumbcast_ic_sports_esports;
+        }
+    }
+
+    /** Akapit w liście (wskazówka nad listą, pusta sekcja „Moje”); nagłówek sekcji to zwykły String. */
+    private static final class Note {
+        final String text;
+
+        Note(String text) {
+            this.text = text;
+        }
+    }
+
+    private final class LibraryAdapter extends BaseAdapter {
+        private static final int TYPE_HEADER = 0;
+        private static final int TYPE_PROFILE = 1;
+        private static final int TYPE_NOTE = 2;
+
+        private final List<Object> items = new ArrayList<>();
+        String activeFile;
+
+        void setData(List<ProfileEntry> presets, List<ProfileEntry> user, String active) {
+            items.clear();
+            activeFile = active;
+            items.add(new Note(getString(R.string.thumbcast_lib_hint)));
+            items.add(getString(R.string.thumbcast_lib_section_builtin));
+            items.addAll(presets);
+            items.add(getString(R.string.thumbcast_lib_section_user));
+            if (user.isEmpty()) {
+                items.add(new Note(getString(R.string.thumbcast_lib_empty_user)));
+            } else {
+                items.addAll(user);
+            }
+            notifyDataSetChanged();
+        }
+
+        @Override
+        public int getCount() {
+            return items.size();
+        }
+
+        @Override
+        public Object getItem(int position) {
+            return items.get(position);
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return position;
+        }
+
+        @Override
+        public int getViewTypeCount() {
+            return 3;
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            Object item = items.get(position);
+            if (item instanceof ProfileEntry) {
+                return TYPE_PROFILE;
+            }
+            return item instanceof Note ? TYPE_NOTE : TYPE_HEADER;
+        }
+
+        @Override
+        public boolean isEnabled(int position) {
+            return getItemViewType(position) == TYPE_PROFILE;
+        }
+
+        @Override
+        public boolean areAllItemsEnabled() {
+            return false;
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            LayoutInflater inflater = LayoutInflater.from(ProfileLibraryActivity.this);
+            Object item = items.get(position);
+            if (item instanceof Note) {
+                TextView note = convertView instanceof TextView ? (TextView) convertView
+                        : (TextView) inflater.inflate(R.layout.thumbcast_profile_note, parent, false);
+                note.setText(((Note) item).text);
+                return note;
+            }
+            if (!(item instanceof ProfileEntry)) {
+                TextView header = convertView instanceof TextView ? (TextView) convertView
+                        : (TextView) inflater.inflate(R.layout.thumbcast_profile_header, parent, false);
+                header.setText((String) item);
+                return header;
+            }
+
+            View row = convertView != null ? convertView
+                    : inflater.inflate(R.layout.thumbcast_profile_item, parent, false);
+            final ProfileEntry entry = (ProfileEntry) item;
+            final boolean isActive = entry.getFileName().equals(activeFile);
+            final boolean valid = entry.isValid();
+
+            ImageView icon = row.findViewById(R.id.thumbcast_profile_icon);
+            TextView name = row.findViewById(R.id.thumbcast_profile_name);
+            TextView badge = row.findViewById(R.id.thumbcast_profile_badge);
+            TextView details = row.findViewById(R.id.thumbcast_profile_details);
+            View main = row.findViewById(R.id.thumbcast_profile_main);
+            final ImageButton more = row.findViewById(R.id.thumbcast_profile_more);
+            View actionsRow = row.findViewById(R.id.thumbcast_profile_actions);
+            Button setDefault = row.findViewById(R.id.thumbcast_profile_set_default);
+            Button edit = row.findViewById(R.id.thumbcast_profile_edit);
+
+            icon.setImageResource(iconFor(entry.getKind()));
+            name.setText(entry.getName());
+            badge.setVisibility(isActive ? View.VISIBLE : View.GONE);
+            if (valid) {
+                String kind = getString(entry.getBuiltIn() ? R.string.thumbcast_library_builtin
+                        : R.string.thumbcast_library_custom);
+                String buttons = getResources().getQuantityString(R.plurals.thumbcast_lib_buttons,
+                        entry.getControlCount(), entry.getControlCount());
+                String text = kind + " · " + modeLabel(entry.getMode()) + " · " + buttons;
+                if (mouseGesturesOn(entry)) {
+                    text += " · " + getString(R.string.thumbcast_library_mouse_gestures_tag);
+                }
+                details.setText(text);
+                details.setTextColor(getColorStateList(R.color.thumbcast_text_secondary_states));
+            } else {
+                details.setText(getString(R.string.thumbcast_library_invalid, entry.getError()));
+                details.setTextColor(getColor(R.color.thumbcast_error));
+            }
+
+            // Akcje w wierszu: „Ustaw jako domyślny” (nie przy domyślnym) i „Edytuj układ”; reszta pod ⋮.
+            setDefault.setVisibility(valid && !isActive ? View.VISIBLE : View.GONE);
+            edit.setVisibility(valid ? View.VISIBLE : View.GONE);
+            actionsRow.setVisibility(valid ? View.VISIBLE : View.GONE);
+            setDefault.setContentDescription(getString(R.string.thumbcast_lib_set_default_description, entry.getName()));
+            edit.setContentDescription(getString(R.string.thumbcast_lib_edit_description, entry.getName()));
+            setDefault.setOnClickListener(v -> select(entry));
+            edit.setOnClickListener(v -> edit(entry, isActive));
+
+            boolean hasMore = hasMoreActions(entry);
+            more.setVisibility(hasMore ? View.VISIBLE : View.INVISIBLE);
+            more.setContentDescription(getString(R.string.thumbcast_lib_more_description, entry.getName()));
+            more.setOnClickListener(v -> showMoreMenu(more, entry));
+            // Dotknięcie wiersza otwiera te same opcje co ⋮ (jak dawniej lista akcji).
+            main.setClickable(hasMore);
+            main.setFocusable(hasMore);
+            main.setOnClickListener(hasMore ? v -> showMoreMenu(more, entry) : null);
+            main.setContentDescription(isActive
+                    ? getString(R.string.thumbcast_lib_row_default_description, entry.getName()) + ", " + details.getText()
+                    : entry.getName() + ", " + details.getText());
+            return row;
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ProfileShareProvider.java b/app/src/main/java/com/limelight/thumbcast/ProfileShareProvider.java
new file mode 100644
index 00000000..cc81a5fb
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ProfileShareProvider.java
@@ -0,0 +1,124 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Minimalny odpowiednik androidx FileProvider dla udostępniania profili:
+// :app nie ma zależności AndroidX (upstream), a potrzebny jest tylko odczyt plików z jednego katalogu.
+// Serwuje wyłącznie cacheDir/shared_profiles/<nazwa>.thumbcast.json, tylko do odczytu, bez eksportu
+// (dostęp tylko przez FLAG_GRANT_READ_URI_PERMISSION w intencji ACTION_SEND).
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.ParcelFileDescriptor;
+import android.provider.OpenableColumns;
+
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+import app.thumbcast.android.library.ProfileRepository;
+
+public class ProfileShareProvider extends ContentProvider {
+
+    private static final String SHARED_DIR = "shared_profiles";
+
+    public static String authority(Context context) {
+        return context.getPackageName() + ".profiles";
+    }
+
+    /**
+     * Zapisuje tekst profilu do katalogu udostępniania (stare pliki są usuwane) i zwraca content:// URI.
+     */
+    public static Uri writeShareFile(Context context, String fileName, String text) throws IOException {
+        File dir = new File(context.getCacheDir(), SHARED_DIR);
+        if (!dir.isDirectory() && !dir.mkdirs()) {
+            throw new IOException("cannot create " + dir);
+        }
+        File[] old = dir.listFiles();
+        if (old != null) {
+            for (File f : old) {
+                //noinspection ResultOfMethodCallIgnored
+                f.delete();
+            }
+        }
+        File out = new File(dir, fileName);
+        try (FileOutputStream os = new FileOutputStream(out)) {
+            os.write(text.getBytes(StandardCharsets.UTF_8));
+        }
+        return new Uri.Builder().scheme("content").authority(authority(context)).appendPath(fileName).build();
+    }
+
+    private File fileFor(Uri uri) throws FileNotFoundException {
+        String name = uri.getLastPathSegment();
+        if (name == null || uri.getPathSegments().size() != 1 || !ProfileRepository.isSafeFileName(name)) {
+            throw new FileNotFoundException("invalid uri");
+        }
+        //noinspection ConstantConditions
+        File dir = new File(getContext().getCacheDir(), SHARED_DIR);
+        File f = new File(dir, name);
+        if (!f.isFile()) {
+            throw new FileNotFoundException(name);
+        }
+        return f;
+    }
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        if (mode != null && !"r".equals(mode)) {
+            throw new SecurityException("read-only");
+        }
+        return ParcelFileDescriptor.open(fileFor(uri), ParcelFileDescriptor.MODE_READ_ONLY);
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs, String sortOrder) {
+        File f;
+        try {
+            f = fileFor(uri);
+        } catch (FileNotFoundException e) {
+            return null;
+        }
+        String[] cols = projection != null ? projection
+                : new String[]{OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE};
+        MatrixCursor cursor = new MatrixCursor(cols, 1);
+        Object[] row = new Object[cols.length];
+        for (int i = 0; i < cols.length; i++) {
+            if (OpenableColumns.DISPLAY_NAME.equals(cols[i])) {
+                row[i] = f.getName();
+            } else if (OpenableColumns.SIZE.equals(cols[i])) {
+                row[i] = f.length();
+            }
+        }
+        cursor.addRow(row);
+        return cursor;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return ProfileRepository.MIME_TYPE;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("read-only");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only");
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only");
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java
new file mode 100644
index 00000000..b76816a4
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java
@@ -0,0 +1,134 @@
+package com.limelight.thumbcast;
+
+import com.limelight.nvstream.http.ComputerDetails;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import app.thumbcast.android.net.AddressBook;
+import app.thumbcast.android.net.AddressEntry;
+import app.thumbcast.android.net.Endpoint;
+import app.thumbcast.android.net.HostAddresses;
+
+/**
+ * Most między polami adresów {@link ComputerDetails} a czystą logiką {@link HostAddresses}
+ * (:control-android, testy JVM). Mapowanie:
+ * <ul>
+ *   <li>{@code localAddress} = slot LAN (nigdy adres VPN),</li>
+ *   <li>{@code manualAddress} + {@code extraAddresses} = lista ręczna (alternatywne i ręczne LAN) w kolejności dodania,</li>
+ *   <li>{@code remoteAddress}, {@code ipv6Address} jak w upstreamie.</li>
+ * </ul>
+ * Opis: patches/host-addresses.patch.md.
+ */
+public final class ThumbcastAddressBook {
+    private ThumbcastAddressBook() {}
+
+    private static Endpoint toEndpoint(ComputerDetails.AddressTuple t) {
+        return t == null ? null : new Endpoint(t.address, t.port);
+    }
+
+    private static ComputerDetails.AddressTuple toTuple(Endpoint e) {
+        return e == null ? null : new ComputerDetails.AddressTuple(e.getHost(), e.getPort());
+    }
+
+    public static AddressBook toBook(ComputerDetails d) {
+        List<Endpoint> manual = new ArrayList<>();
+        if (d.manualAddress != null) {
+            manual.add(toEndpoint(d.manualAddress));
+        }
+        if (d.extraAddresses != null) {
+            for (ComputerDetails.AddressTuple t : d.extraAddresses) {
+                Endpoint e = toEndpoint(t);
+                if (e != null && !manual.contains(e)) {
+                    manual.add(e);
+                }
+            }
+        }
+        return new AddressBook(toEndpoint(d.localAddress), manual,
+                toEndpoint(d.remoteAddress), toEndpoint(d.ipv6Address));
+    }
+
+    /** Zapisuje slot LAN i listę ręczną (remote i ipv6 zostają bez zmian). */
+    private static void writeLocalAndManual(ComputerDetails d, AddressBook b) {
+        ComputerDetails.AddressTuple local = toTuple(b.getLocal());
+        List<ComputerDetails.AddressTuple> manual = new ArrayList<>();
+        for (Endpoint e : b.getManual()) {
+            manual.add(toTuple(e));
+        }
+        d.localAddress = local;
+        d.manualAddress = manual.isEmpty() ? null : manual.get(0);
+        d.extraAddresses = manual.size() > 1 ? new ArrayList<>(manual.subList(1, manual.size())) : new ArrayList<>();
+    }
+
+    /** Pełny zapis (także remote i ipv6), np. po usunięciu adresu w dialogu. */
+    private static void writeAll(ComputerDetails d, AddressBook b) {
+        ComputerDetails.AddressTuple remote = toTuple(b.getRemote());
+        ComputerDetails.AddressTuple ipv6 = toTuple(b.getIpv6());
+        writeLocalAndManual(d, b);
+        d.remoteAddress = remote;
+        d.ipv6Address = ipv6;
+    }
+
+    /** Migracja wpisu z bazy (adres VPN zapisany przez starszą wersję w slocie LAN). */
+    public static void migrate(ComputerDetails d) {
+        writeLocalAndManual(d, HostAddresses.normalize(toBook(d)));
+    }
+
+    /**
+     * Wywoływane w {@code ComputerDetails.update()} zamiast nadpisywania localAddress i manualAddress.
+     */
+    public static void mergeInto(ComputerDetails target, ComputerDetails incoming) {
+        AddressBook incomingBook = toBook(incoming);
+        // Upstream: loopback IPv4 z GS IPv6 Forwarder nie jest adresem LAN (decideLocal też go odrzuca).
+        writeLocalAndManual(target, HostAddresses.merge(toBook(target), incomingBook));
+    }
+
+    /**
+     * Przed {@code details.update(polled)}: decyduje o slocie LAN na podstawie {@code LocalIP} i adresu,
+     * który odpowiedział. Ustawia {@code polled.localAddress} na wynik, żeby update() go nie nadpisał.
+     */
+    public static void applyPollReply(ComputerDetails details, ComputerDetails polled) {
+        AddressBook after = HostAddresses.applyPollReply(toBook(details),
+                toEndpoint(polled.localAddress), toEndpoint(polled.activeAddress));
+        writeLocalAndManual(details, after);
+        polled.localAddress = details.localAddress;
+    }
+
+    /** Kolejność odpytywania: LAN, potem alternatywne. */
+    public static List<ComputerDetails.AddressTuple> pollOrder(ComputerDetails d) {
+        List<ComputerDetails.AddressTuple> out = new ArrayList<>();
+        for (Endpoint e : HostAddresses.pollOrder(toBook(d))) {
+            out.add(toTuple(e));
+        }
+        return out;
+    }
+
+    public static List<AddressEntry> entries(ComputerDetails d) {
+        return HostAddresses.entries(toBook(d), toEndpoint(d.activeAddress));
+    }
+
+    /** @return true, jeśli adres został dodany (false: już był). */
+    public static boolean addManual(ComputerDetails d, ComputerDetails.AddressTuple t) {
+        AddressBook before = HostAddresses.normalize(toBook(d));
+        AddressBook after = HostAddresses.addManual(before, toEndpoint(t));
+        if (after.equals(before)) {
+            return false;
+        }
+        writeAll(d, after);
+        return true;
+    }
+
+    /** @return true, jeśli coś usunięto. */
+    public static boolean remove(ComputerDetails d, ComputerDetails.AddressTuple t) {
+        AddressBook before = HostAddresses.normalize(toBook(d));
+        AddressBook after = HostAddresses.remove(before, toEndpoint(t));
+        if (after.equals(before)) {
+            return false;
+        }
+        writeAll(d, after);
+        if (t.equals(d.activeAddress)) {
+            d.activeAddress = null;
+        }
+        return true;
+    }
+}
