+<?xml version="1.0" encoding="utf-8"?>
+<!-- THUMBCAST: teksty preferencji warstwy sterowania (patches/preferences.patch.md, pkt 3). -->
+<resources>
+    <string name="category_thumbcast">Sterowanie dotykowe</string>
