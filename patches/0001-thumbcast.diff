+    // =====================================================================================
+    // Menu w grze (widok nad overlayem w oknie aktywności, bez osobnego okna)
+    // =====================================================================================
+
+    private boolean isMenuShown() {
+        return menuView != null && menuView.getParent() != null;
+    }
+
+    private void showMenu() {
+        if (destroyed || activity.isFinishing()) {
+            return;
+        }
+        // Nic nie może zostać wciśnięte na hoście. Palce, które jeszcze leżą na overlayu, po releaseAll
+        // nie są śledzone (translator ignoruje ich MOVE), a nowe trafiają w menu, które konsumuje każdy dotyk.
+        releaseHostInput();
+        if (menuView == null) {
+            menuView = new ThumbcastMenuView(activity, menuListener);
+        }
+        if (menuView.getParent() == null) {
+            menuInput.resetAxes();
+            setPhysicalInputBlocked(true);
+            // Ostatnie dziecko: rysowane nad overlayem i pierwsze w kolejce dotyku.
+            overlayParent.addView(menuView, new FrameLayout.LayoutParams(
+                    FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
+            menuView.clearSelection();
+            menuView.scrollToTop();
+        }
+        refreshMenu();
+    }
+
+    /**
+     * Zerowy stan na hoście: nakładka (pad, klawisze, mysz; releaseAll jak przy ukryciu, PiP i utracie fokusu)
+     * i pady fizyczne (Game nie przekazuje ich zdarzeń, dopóki menu jest otwarte, więc puszczenie przycisku
+     * albo powrót gałki nie dotarłby do hosta). Klawisze klawiatury fizycznej wciśnięte przed menu puszcza ich
+     * własne zdarzenie ACTION_UP, które MenuInputRouter przepuszcza do hosta.
+     */
+    private void releaseHostInput() {
+        overlay.releaseAll();
+        controllerHandler.releaseAllControllerInput();
+    }
+
+    /** Pady z własnego sterownika USB omijają Game: ControllerHandler blokuje je sam, dopóki menu jest otwarte. */
+    private void setPhysicalInputBlocked(boolean blocked) {
+        controllerHandler.setThumbcastInputBlocked(blocked);
+    }
+
+    /** Zamknięcie bez akcji (Wróć do gry, tap w tło, Back, PiP, onDestroy). */
+    private void hideMenu() {
+        if (isMenuShown()) {
+            overlayParent.removeView(menuView);
+        }
+        menuPage = MenuPage.MAIN;
+        menuInput.resetAxes();
+        setPhysicalInputBlocked(false);
+    }
+
+    /** B, Back, Escape przy otwartym menu: z podstrony na stronę główną, ze strony głównej do gry. */
+    private void onMenuBack() {
+        MenuPage back = menuPage.back();
+        if (back != null) {
+            showPage(back);
+        } else {
+            hideMenu();
+        }
+    }
+
+    private void showPage(MenuPage page) {
+        if (page == MenuPage.PROFILES) {
+            profileChoices = loadProfileChoices();
+        }
+        menuPage = page;
+        refreshMenu();
+        if (isMenuShown()) {
+            menuView.scrollToTop();
+        }
+    }
+
+    /** Profile z biblioteki (presety, potem profile użytkownika), bez plików uszkodzonych. */
+    private List<ThumbcastMenuModel.ProfileChoice> loadProfileChoices() {
+        List<ThumbcastMenuModel.ProfileChoice> out = new ArrayList<>();
+        String defaultFile = ProfileLibraryActivity.defaultProfileFile(activity);
+        try {
+            for (ProfileEntry e : ProfileRepository.create(activity).listAll()) {
+                if (e.isValid()) {
+                    out.add(new ThumbcastMenuModel.ProfileChoice(e.getFileName(), e.getName(),
+                            e.getFileName().equals(activeProfileFile), e.getFileName().equals(defaultFile)));
+                }
+            }
+        } catch (RuntimeException e) {
+            LimeLog.warning("Thumbcast: profile list failed: " + e);
+        }
+        return out;
+    }
+
+    /** Nazwa wyświetlana aktywnego profilu (pole name z pliku). */
+    private String activeProfileName() {
+        return baseProfile.getName();
+    }
+
+    /**
+     * Zmiana profilu na żywo. Najpierw zerowy stan na hoście (nakładka i pady), potem nowy profil w overlayu
+     * (setProfile: releaseAll, silnik z nowym profilem, układ i haptyka) z bieżącą skalą i regułą ukrywania.
+     */
+    private void switchProfile(String fileName) {
+        if (destroyed || fileName == null || fileName.equals(activeProfileFile)) {
+            return;
+        }
+        Profile loaded = ThumbcastProfiles.loadOrNull(activity, fileName);
+        if (loaded == null) {
+            Toast.makeText(activity, activity.getString(R.string.thumbcast_menu_profile_switch_error,
+                    String.valueOf(ThumbcastProfiles.getLastError())), Toast.LENGTH_LONG).show();
+            return;
+        }
+        releaseHostInput();
+        baseProfile = ThumbcastOverlayFactory.withAutoHideOnGamepad(loaded, false);
+        activeProfileFile = fileName;
+        mouseGestures = settings.getMouseGestures(fileName);
+        if (!sessionOnlyProfile) {
+            prefConfig.thumbcastProfileFile = fileName;
+            PreferenceManager.getDefaultSharedPreferences(activity).edit()
+                    .putString(ProfileLibraryActivity.PREF_PROFILE, fileName).apply();
+        }
+        overlay.setProfile(effectiveProfile());
+        applyControlsHidden();
+        Toast.makeText(activity, activity.getString(sessionOnlyProfile
+                ? R.string.thumbcast_menu_profile_session_only : R.string.thumbcast_library_default_set,
+                loaded.getName()), Toast.LENGTH_SHORT).show();
+    }
+
+    /** Polecenie z klawiatury lub pada przy otwartym menu. */
+    private void onMenuCommand(MenuCommand command) {
+        if (!isMenuShown()) {
+            return;
+        }
+        if (command == MenuCommand.BACK) {
+            onMenuBack();
+        } else {
+            menuView.handleCommand(command);
+        }
+    }
+
+    private void refreshMenu() {
+        if (!isMenuShown()) {
+            return;
+        }
+        if (menuPage == MenuPage.PROFILES) {
+            // Wybór w grze zmienia profil domyślny, chyba że sesja ma profil przypisany do aplikacji.
+            menuView.setTitle(menuString(sessionOnlyProfile ? R.string.thumbcast_menu_profiles_title_session
+                    : R.string.thumbcast_menu_profiles_title));
+            menuView.bind(ThumbcastMenuModel.buildProfiles(this::menuString, profileChoices, menuTarget));
+        } else if (menuPage == MenuPage.END_SESSION) {
+            menuView.setTitle(menuString(R.string.thumbcast_menu_end_session_title));
+            menuView.bind(ThumbcastMenuModel.buildEndSession(this::menuString, menuTarget));
+        } else {
+            menuView.setTitle(menuString(R.string.thumbcast_menu_title));
+            menuView.bind(ThumbcastMenuModel.build(this::menuString, menuTarget));
+        }
+    }
+
+    private String menuString(int resId, Object... args) {
+        return args.length == 0 ? activity.getString(resId) : activity.getString(resId, args);
+    }
+
+    private final ThumbcastMenuView.Listener menuListener = new ThumbcastMenuView.Listener() {
+        @Override
+        public void onMenuAction(ThumbcastMenuModel.Item item, Runnable action) {
+            if (destroyed || !isMenuShown()) {
+                return;
+            }
+            if (item.closesMenu) {
+                hideMenu();
+            }
+            action.run();
+            refreshMenu();
+        }
+
+        @Override
+        public void onDismissRequested() {
+            hideMenu();
+        }
+    };
+
+    private final ThumbcastMenuModel.Target menuTarget = new ThumbcastMenuModel.Target() {
+        @Override
+        public void disconnect() {
+            host.disconnect();
+        }
+
+        @Override
+        public boolean areControlsHidden() {
+            return overlay.getControlsHidden();
+        }
+
+        @Override
+        public void toggleControls() {
+            ThumbcastSession.this.toggleControls();
+        }
+
+        @Override
+        public void toggleKeyboard() {
+            // Okno aktywności nie traci fokusu (menu to widok, nie dialog), więc dawne opóźnienie 200 ms
+            // nie jest potrzebne. Zostaje post: klawiatura po zdjęciu menu, poza obsługą kliknięcia.
+            mainHandler.post(() -> {
+                if (!destroyed) {
+                    host.toggleKeyboard();
+                }
+            });
+        }
+
+        @Override
+        public int getScalePercent() {
+            return scalePercent;
+        }
+
+        @Override
+        public void setScalePercent(int percent) {
+            applyScale(percent);
+        }
+
+        @Override
+        public boolean isHideOnGamepad() {
+            return hideOnGamepad;
+        }
+
+        @Override
+        public void setHideOnGamepad(boolean hide) {
+            ThumbcastSession.this.setHideOnGamepad(hide);
+        }
+
+        @Override
+        public String getActiveProfileName() {
+            return activeProfileName();
+        }
+
+        @Override
+        public void openProfiles() {
+            showPage(MenuPage.PROFILES);
+        }
+
+        @Override
+        public void showMainPage() {
+            showPage(MenuPage.MAIN);
+        }
+
+        @Override
+        public void openEndSession() {
+            showPage(MenuPage.END_SESSION);
+        }
+
+        @Override
+        public void endSession() {
+            ThumbcastSession.this.endSession();
+        }
+
+        @Override
+        public StatsToggles getStatsToggles() {
+            return currentStatsToggles();
+        }
+
+        @Override
+        public void setStatsToggles(StatsToggles toggles) {
+            ThumbcastSession.this.setStatsToggles(toggles);
+        }
+
+        @Override
+        public void switchProfile(String fileName) {
+            ThumbcastSession.this.switchProfile(fileName);
+        }
+
+        @Override
+        public boolean isMouseGestures() {
+            return ThumbcastSession.this.isMouseGestures();
+        }
+
+        @Override
+        public void setMouseGestures(boolean enabled) {
+            ThumbcastSession.this.setMouseGestures(enabled);
+        }
+    };
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastSettings.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastSettings.java
new file mode 100644
index 00000000..dfa62801
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastSettings.java
@@ -0,0 +1,137 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Ustawienia Thumbcast zmieniane także z menu w grze, więc mają własny
+// odczyt/zapis zamiast pól w upstreamowym PreferenceConfiguration (ten czyta wszystko raz, przy starcie).
+// Klucze są te same, co w kategorii „Sterowanie dotykowe” w preferences.xml.
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.preference.PreferenceManager;
+
+import app.thumbcast.android.stats.StatsToggles;
+
+public final class ThumbcastSettings {
+
+    /** ListPreference: wartości tekstowe "60" … "130" (procent rozmiaru kontrolek). */
+    public static final String KEY_CONTROL_SCALE = "list_thumbcast_control_scale";
+    public static final String KEY_HIDE_ON_GAMEPAD = "checkbox_thumbcast_hide_on_gamepad";
+
+    /**
+     * 100% = rozmiar z presetu. Od 11.11.2026 presety mają rozmiar, który właściciel uznał za normę
+     * na telefonie (wcześniejsze 85%), więc domyślnie nic nie jest skalowane.
+     */
+    public static final int DEFAULT_SCALE_PERCENT = 100;
+    public static final boolean DEFAULT_HIDE_ON_GAMEPAD = true;
+
+    /** Wartości z menu w grze i z ekranu ustawień (thumbcast_control_scale_values). */
+    static final int[] SCALE_PERCENTS = {60, 70, 85, 100, 115, 130};
+
+    /** Jednorazowa migracja: zapisane 85% (stara norma) to po zmniejszeniu presetów 100%. */
+    private static final String KEY_SCALE_REBASED = "thumbcast_control_scale_rebased";
+    private static final String OLD_NORM_PERCENT = "85";
+
+    private final SharedPreferences prefs;
+
+    public ThumbcastSettings(Context context) {
+        prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        migrateScale();
+    }
+
+    private void migrateScale() {
+        if (prefs.getBoolean(KEY_SCALE_REBASED, false)) {
+            return;
+        }
+        SharedPreferences.Editor e = prefs.edit().putBoolean(KEY_SCALE_REBASED, true);
+        if (OLD_NORM_PERCENT.equals(prefs.getString(KEY_CONTROL_SCALE, null))) {
+            e.putString(KEY_CONTROL_SCALE, String.valueOf(DEFAULT_SCALE_PERCENT));
+        }
+        e.apply();
+    }
+
+    public int getControlScalePercent() {
+        String raw = prefs.getString(KEY_CONTROL_SCALE, null);
+        if (raw == null) {
+            return DEFAULT_SCALE_PERCENT;
+        }
+        try {
+            int v = Integer.parseInt(raw.trim());
+            if (v < SCALE_PERCENTS[0] || v > SCALE_PERCENTS[SCALE_PERCENTS.length - 1]) {
+                return DEFAULT_SCALE_PERCENT;
+            }
+            return v;
+        } catch (NumberFormatException e) {
+            return DEFAULT_SCALE_PERCENT;
+        }
+    }
+
+    public float getControlScale() {
+        return getControlScalePercent() / 100f;
+    }
+
+    public void setControlScalePercent(int percent) {
+        prefs.edit().putString(KEY_CONTROL_SCALE, String.valueOf(percent)).apply();
+    }
+
+    public boolean isHideOnGamepad() {
+        return prefs.getBoolean(KEY_HIDE_ON_GAMEPAD, DEFAULT_HIDE_ON_GAMEPAD);
+    }
+
+    public void setHideOnGamepad(boolean hide) {
+        prefs.edit().putBoolean(KEY_HIDE_ON_GAMEPAD, hide).apply();
+    }
+
+    // ---------- Nakładka statystyk (12.11.2026): menu w grze, StatsToggles ----------
+
+    /**
+     * „Statystyki” = upstreamowy klucz „Pokaż statystyki wydajności” (PreferenceConfiguration.enablePerfOverlay),
+     * więc pole wyboru w ustawieniach i przełącznik w menu w grze to ten sam stan (wł. = linia podstawowa).
+     */
+    public static final String KEY_PERF_OVERLAY = "checkbox_enable_perf_overlay";
+    /** „Szczegółowe statystyki” (tylko tryb Thumbcast), domyślnie wył. */
+    public static final String KEY_PERF_OVERLAY_ADVANCED = "checkbox_thumbcast_perf_advanced";
+
+    public StatsToggles getStatsToggles() {
+        return new StatsToggles(prefs.getBoolean(KEY_PERF_OVERLAY, false),
+                prefs.getBoolean(KEY_PERF_OVERLAY_ADVANCED, false));
+    }
+
+    public void setStatsToggles(StatsToggles toggles) {
+        prefs.edit().putBoolean(KEY_PERF_OVERLAY, toggles.getEnabled())
+                .putBoolean(KEY_PERF_OVERLAY_ADVANCED, toggles.getAdvanced()).apply();
+    }
+
+    // ---------- Gesty myszy (12.11.2026): przełącznik na profil, MouseGesturesTransform ----------
+
+    /**
+     * Klucz = prefiks + nazwa pliku profilu (wartość list_thumbcast_profile), więc działa także dla presetów
+     * tylko do odczytu. Brak wpisu = zachowanie zapisane w profilu (MouseGesturesTransform.isEnabled).
+     */
+    static final String KEY_MOUSE_GESTURES_PREFIX = "thumbcast_mouse_gestures:";
+
+    /** Zapisany wybór dla pliku profilu albo null (profil działa tak, jak go zapisano). */
+    public Boolean getMouseGestures(String profileFile) {
+        String key = KEY_MOUSE_GESTURES_PREFIX + profileFile;
+        if (profileFile == null || !prefs.contains(key)) {
+            return null;
+        }
+        return prefs.getBoolean(key, false);
+    }
+
+    /** {@code value} = MouseGesturesTransform.toStore(...): null usuwa wpis (wartość równa domyślnej profilu). */
+    public void setMouseGestures(String profileFile, Boolean value) {
+        if (profileFile == null) {
+            return;
+        }
+        String key = KEY_MOUSE_GESTURES_PREFIX + profileFile;
+        if (value == null) {
+            prefs.edit().remove(key).apply();
+        } else {
+            prefs.edit().putBoolean(key, value).apply();
+        }
+    }
+
+    /** Przeniesienie wyboru na kopię profilu (Duplikuj, edycja presetu). */
+    public void copyMouseGestures(String fromFile, String toFile) {
+        setMouseGestures(toFile, getMouseGestures(fromFile));
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastStatsView.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastStatsView.java
new file mode 100644
index 00000000..d7c6d5be
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastStatsView.java
@@ -0,0 +1,139 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Nakładka statystyk strumienia w trybie Thumbcast (12.11.2026): mały tekst na półprzezroczystym
+// czarnym tle w prawym górnym rogu obszaru bezpiecznego (bez wycięcia ekranu i pasków), przesuwana tak, żeby nie
+// zasłaniała kontrolek (StatsPlacement z :control-android). Tekst i tryb (podstawowy / szczegółowy) ustawia
+// ThumbcastSession. Widok nie bierze dotyku ani fokusu i leży pod overlayem kontrolek w kolejności rysowania.
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Build;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.WindowInsets;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import java.util.List;
+
+import app.thumbcast.android.overlay.PxRect;
+import app.thumbcast.android.stats.StatsPlacement;
+
+@SuppressLint({"ViewConstructor", "AppCompatCustomView"})
+final class ThumbcastStatsView extends TextView {
+
+    private static final int BACKGROUND_COLOR = 0x99000000;
+    private static final int TEXT_COLOR = 0xFFFFFFFF;
+    private static final float TEXT_SP = 11f;
+    private static final int PADDING_H_DP = 6;
+    private static final int PADDING_V_DP = 3;
+    private static final int CORNER_DP = 4;
+    /** Odstęp od krawędzi obszaru bezpiecznego i od kontrolek. */
+    private static final int MARGIN_DP = 6;
+
+    private final float density;
+
+    ThumbcastStatsView(Context context) {
+        super(context);
+        density = getResources().getDisplayMetrics().density;
+        setTextColor(TEXT_COLOR);
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, TEXT_SP);
+        setTypeface(Typeface.DEFAULT);
+        // Cyfry o stałej szerokości: zmieniające się liczby nie przesuwają ramki co sekundę.
+        setFontFeatureSettings("tnum");
+        setIncludeFontPadding(false);
+        setGravity(Gravity.START);
+        setPadding(dp(PADDING_H_DP), dp(PADDING_V_DP), dp(PADDING_H_DP), dp(PADDING_V_DP));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(BACKGROUND_COLOR);
+        bg.setCornerRadius(dp(CORNER_DP));
+        setBackground(bg);
+        setClickable(false);
+        setLongClickable(false);
+        setFocusable(View.NOT_FOCUSABLE);
+        setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+    }
+
+    /** Parametry do dodania w rodzicu StreamView: rozmiar wg treści, pozycja przez translację. */
+    static FrameLayout.LayoutParams layoutParams() {
+        return new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.START);
+    }
+
+    /** Nakładka nigdy nie bierze dotyku: zdarzenie idzie dalej do overlaya i strumienia. */
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent event) {
+        return false;
+    }
+
+    @Override
+    public boolean dispatchGenericMotionEvent(MotionEvent event) {
+        return false;
+    }
+
+    /**
+     * Nowy tekst i położenie. {@code obstacles} = prostokąty kontrolek (i innych napisów) w px rodzica.
+     * Rozmiar liczony od razu (measure), więc położenie pasuje do nowego tekstu w tej samej klatce.
+     */
+    void show(CharSequence text, List<PxRect> obstacles) {
+        if (!text.toString().contentEquals(getText())) {
+            setText(text);
+        }
+        View parent = (View) getParent();
+        if (parent == null || parent.getWidth() <= 0 || parent.getHeight() <= 0) {
+            return;
+        }
+        int pw = parent.getWidth();
+        int ph = parent.getHeight();
+        measure(MeasureSpec.makeMeasureSpec(pw, MeasureSpec.AT_MOST),
+                MeasureSpec.makeMeasureSpec(ph, MeasureSpec.AT_MOST));
+        StatsPlacement.Position p = StatsPlacement.place(pw, ph, safeArea(parent, pw, ph),
+                getMeasuredWidth(), getMeasuredHeight(), dp(MARGIN_DP), obstacles);
+        setTranslationX(Math.round(p.getX()));
+        setTranslationY(Math.round(p.getY()));
+    }
+
+    /**
+     * Obszar bezpieczny w układzie rodzica: rodzic (FrameLayout treści aktywności) wypełnia okno, więc wcięcia okna
+     * (wycięcie ekranu, widoczne paski systemowe) odejmujemy od jego krawędzi.
+     */
+    @SuppressWarnings("deprecation")
+    private static PxRect safeArea(View parent, int pw, int ph) {
+        WindowInsets insets = parent.getRootWindowInsets();
+        int l = 0;
+        int t = 0;
+        int r = 0;
+        int b = 0;
+        if (insets != null) {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                android.graphics.Insets i = insets.getInsets(
+                        WindowInsets.Type.systemBars() | WindowInsets.Type.displayCutout());
+                l = i.left;
+                t = i.top;
+                r = i.right;
+                b = i.bottom;
+            } else {
+                l = insets.getSystemWindowInsetLeft();
+                t = insets.getSystemWindowInsetTop();
+                r = insets.getSystemWindowInsetRight();
+                b = insets.getSystemWindowInsetBottom();
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P && insets.getDisplayCutout() != null) {
+                    l = Math.max(l, insets.getDisplayCutout().getSafeInsetLeft());
+                    t = Math.max(t, insets.getDisplayCutout().getSafeInsetTop());
+                    r = Math.max(r, insets.getDisplayCutout().getSafeInsetRight());
+                    b = Math.max(b, insets.getDisplayCutout().getSafeInsetBottom());
+                }
+            }
+        }
+        return new PxRect(l, t, pw - r, ph - b);
+    }
+
+    private int dp(int value) {
+        return Math.round(value * density);
+    }
+}
