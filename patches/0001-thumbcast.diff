+
+    private TextView newFooterText(String text) {
+        TextView t = new TextView(getContext());
+        t.setText(text);
+        t.setTextColor(colorTextSecondary);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
