+
+import app.thumbcast.android.library.ProfileRepository;
+
+public class ProfileShareProvider extends ContentProvider {
+
+    private static final String SHARED_DIR = "shared_profiles";
+
+    public static String authority(Context context) {
+        return context.getPackageName() + ".profiles";
+    }
+
+    /**
+     * Zapisuje tekst profilu do katalogu udostępniania (stare pliki są usuwane) i zwraca content:// URI.
+     */
+    public static Uri writeShareFile(Context context, String fileName, String text) throws IOException {
+        File dir = new File(context.getCacheDir(), SHARED_DIR);
+        if (!dir.isDirectory() && !dir.mkdirs()) {
+            throw new IOException("cannot create " + dir);
+        }
+        File[] old = dir.listFiles();
+        if (old != null) {
+            for (File f : old) {
+                //noinspection ResultOfMethodCallIgnored
+                f.delete();
+            }
+        }
+        File out = new File(dir, fileName);
+        try (FileOutputStream os = new FileOutputStream(out)) {
+            os.write(text.getBytes(StandardCharsets.UTF_8));
+        }
+        return new Uri.Builder().scheme("content").authority(authority(context)).appendPath(fileName).build();
+    }
+
+    private File fileFor(Uri uri) throws FileNotFoundException {
+        String name = uri.getLastPathSegment();
+        if (name == null || uri.getPathSegments().size() != 1 || !ProfileRepository.isSafeFileName(name)) {
+            throw new FileNotFoundException("invalid uri");
+        }
+        //noinspection ConstantConditions
+        File dir = new File(getContext().getCacheDir(), SHARED_DIR);
+        File f = new File(dir, name);
+        if (!f.isFile()) {
+            throw new FileNotFoundException(name);
+        }
+        return f;
+    }
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        if (mode != null && !"r".equals(mode)) {
+            throw new SecurityException("read-only");
+        }
+        return ParcelFileDescriptor.open(fileFor(uri), ParcelFileDescriptor.MODE_READ_ONLY);
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs, String sortOrder) {
+        File f;
+        try {
+            f = fileFor(uri);
+        } catch (FileNotFoundException e) {
+            return null;
+        }
+        String[] cols = projection != null ? projection
+                : new String[]{OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE};
+        MatrixCursor cursor = new MatrixCursor(cols, 1);
+        Object[] row = new Object[cols.length];
+        for (int i = 0; i < cols.length; i++) {
+            if (OpenableColumns.DISPLAY_NAME.equals(cols[i])) {
+                row[i] = f.getName();
+            } else if (OpenableColumns.SIZE.equals(cols[i])) {
+                row[i] = f.length();
+            }
+        }
+        cursor.addRow(row);
+        return cursor;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return ProfileRepository.MIME_TYPE;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("read-only");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only");
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("read-only");
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java
new file mode 100644
index 00000000..b76816a4
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastAddressBook.java
@@ -0,0 +1,134 @@
+package com.limelight.thumbcast;
+
+import com.limelight.nvstream.http.ComputerDetails;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import app.thumbcast.android.net.AddressBook;
+import app.thumbcast.android.net.AddressEntry;
+import app.thumbcast.android.net.Endpoint;
+import app.thumbcast.android.net.HostAddresses;
+
+/**
+ * Most między polami adresów {@link ComputerDetails} a czystą logiką {@link HostAddresses}
+ * (:control-android, testy JVM). Mapowanie:
+ * <ul>
+ *   <li>{@code localAddress} = slot LAN (nigdy adres VPN),</li>
+ *   <li>{@code manualAddress} + {@code extraAddresses} = lista ręczna (alternatywne i ręczne LAN) w kolejności dodania,</li>
+ *   <li>{@code remoteAddress}, {@code ipv6Address} jak w upstreamie.</li>
+ * </ul>
+ * Opis: patches/host-addresses.patch.md.
+ */
+public final class ThumbcastAddressBook {
+    private ThumbcastAddressBook() {}
+
+    private static Endpoint toEndpoint(ComputerDetails.AddressTuple t) {
+        return t == null ? null : new Endpoint(t.address, t.port);
+    }
+
+    private static ComputerDetails.AddressTuple toTuple(Endpoint e) {
+        return e == null ? null : new ComputerDetails.AddressTuple(e.getHost(), e.getPort());
+    }
+
+    public static AddressBook toBook(ComputerDetails d) {
+        List<Endpoint> manual = new ArrayList<>();
+        if (d.manualAddress != null) {
+            manual.add(toEndpoint(d.manualAddress));
+        }
+        if (d.extraAddresses != null) {
+            for (ComputerDetails.AddressTuple t : d.extraAddresses) {
+                Endpoint e = toEndpoint(t);
+                if (e != null && !manual.contains(e)) {
+                    manual.add(e);
+                }
+            }
+        }
+        return new AddressBook(toEndpoint(d.localAddress), manual,
+                toEndpoint(d.remoteAddress), toEndpoint(d.ipv6Address));
+    }
+
+    /** Zapisuje slot LAN i listę ręczną (remote i ipv6 zostają bez zmian). */
+    private static void writeLocalAndManual(ComputerDetails d, AddressBook b) {
+        ComputerDetails.AddressTuple local = toTuple(b.getLocal());
+        List<ComputerDetails.AddressTuple> manual = new ArrayList<>();
+        for (Endpoint e : b.getManual()) {
+            manual.add(toTuple(e));
+        }
+        d.localAddress = local;
+        d.manualAddress = manual.isEmpty() ? null : manual.get(0);
+        d.extraAddresses = manual.size() > 1 ? new ArrayList<>(manual.subList(1, manual.size())) : new ArrayList<>();
+    }
+
+    /** Pełny zapis (także remote i ipv6), np. po usunięciu adresu w dialogu. */
+    private static void writeAll(ComputerDetails d, AddressBook b) {
+        ComputerDetails.AddressTuple remote = toTuple(b.getRemote());
+        ComputerDetails.AddressTuple ipv6 = toTuple(b.getIpv6());
+        writeLocalAndManual(d, b);
+        d.remoteAddress = remote;
+        d.ipv6Address = ipv6;
+    }
+
+    /** Migracja wpisu z bazy (adres VPN zapisany przez starszą wersję w slocie LAN). */
+    public static void migrate(ComputerDetails d) {
+        writeLocalAndManual(d, HostAddresses.normalize(toBook(d)));
+    }
+
+    /**
+     * Wywoływane w {@code ComputerDetails.update()} zamiast nadpisywania localAddress i manualAddress.
+     */
+    public static void mergeInto(ComputerDetails target, ComputerDetails incoming) {
+        AddressBook incomingBook = toBook(incoming);
+        // Upstream: loopback IPv4 z GS IPv6 Forwarder nie jest adresem LAN (decideLocal też go odrzuca).
+        writeLocalAndManual(target, HostAddresses.merge(toBook(target), incomingBook));
+    }
+
+    /**
+     * Przed {@code details.update(polled)}: decyduje o slocie LAN na podstawie {@code LocalIP} i adresu,
+     * który odpowiedział. Ustawia {@code polled.localAddress} na wynik, żeby update() go nie nadpisał.
+     */
+    public static void applyPollReply(ComputerDetails details, ComputerDetails polled) {
+        AddressBook after = HostAddresses.applyPollReply(toBook(details),
+                toEndpoint(polled.localAddress), toEndpoint(polled.activeAddress));
+        writeLocalAndManual(details, after);
+        polled.localAddress = details.localAddress;
+    }
+
+    /** Kolejność odpytywania: LAN, potem alternatywne. */
+    public static List<ComputerDetails.AddressTuple> pollOrder(ComputerDetails d) {
+        List<ComputerDetails.AddressTuple> out = new ArrayList<>();
+        for (Endpoint e : HostAddresses.pollOrder(toBook(d))) {
+            out.add(toTuple(e));
+        }
+        return out;
+    }
+
+    public static List<AddressEntry> entries(ComputerDetails d) {
+        return HostAddresses.entries(toBook(d), toEndpoint(d.activeAddress));
+    }
+
+    /** @return true, jeśli adres został dodany (false: już był). */
+    public static boolean addManual(ComputerDetails d, ComputerDetails.AddressTuple t) {
+        AddressBook before = HostAddresses.normalize(toBook(d));
+        AddressBook after = HostAddresses.addManual(before, toEndpoint(t));
+        if (after.equals(before)) {
+            return false;
+        }
+        writeAll(d, after);
+        return true;
+    }
+
+    /** @return true, jeśli coś usunięto. */
+    public static boolean remove(ComputerDetails d, ComputerDetails.AddressTuple t) {
+        AddressBook before = HostAddresses.normalize(toBook(d));
+        AddressBook after = HostAddresses.remove(before, toEndpoint(t));
+        if (after.equals(before)) {
+            return false;
+        }
+        writeAll(d, after);
+        if (t.equals(d.activeAddress)) {
+            d.activeAddress = null;
+        }
+        return true;
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettings.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettings.java
new file mode 100644
index 00000000..5811d5da
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettings.java
@@ -0,0 +1,92 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Ustawienia Thumbcast dla aplikacji hosta (Sunshine „Applications”): profil sterowania,
+// rozdzielczość i FPS dla strumieni jednej aplikacji. Zapis na telefonie, w osobnym pliku SharedPreferences
+// (jak upstreamowy „HiddenApps”): klucz = uuid PC (HostAppSettings.hostKey), wartość = JSON z wpisami aplikacji
+// (id z listy aplikacji + nazwa jako klucz zapasowy). Logika bez Androida: :control-android, pakiet apps.
+//
+// Na start strumienia (Game.onCreate, zaraz po readPreferences) applyToStream nadpisuje tylko obiekt
+// PreferenceConfiguration tego strumienia: width/height/fps (trafiają do StreamConfiguration i do hosta w /launch)
+// i thumbcastAppProfileFile (ThumbcastSession). Preferencje globalne się nie zmieniają.
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+
+import com.limelight.Game;
+import com.limelight.LimeLog;
+import com.limelight.nvstream.StreamConfiguration;
+import com.limelight.preferences.PreferenceConfiguration;
+
+import app.thumbcast.android.apps.AppStreamOverrides;
+import app.thumbcast.android.apps.AppStreamSettings;
+import app.thumbcast.android.apps.HostAppSettings;
+import app.thumbcast.android.apps.StreamParams;
+
+public final class ThumbcastAppSettings {
+
+    /** Plik SharedPreferences (data/shared_prefs/ThumbcastAppSettings.xml). */
+    public static final String PREFS_FILE = "ThumbcastAppSettings";
+
+    private ThumbcastAppSettings() {
+    }
+
+    /** Ustawienia wszystkich aplikacji jednego PC (pusta lista, gdy brak albo uszkodzone). */
+    public static HostAppSettings load(Context context, String pcUuid) {
+        String key = HostAppSettings.hostKey(pcUuid);
+        if (key == null) {
+            return HostAppSettings.EMPTY;
+        }
+        return HostAppSettings.decode(prefs(context).getString(key, null));
+    }
+
+    /** Ustawienia jednej aplikacji ({@link AppStreamSettings#NONE}, gdy nic nie przypisano). */
+    public static AppStreamSettings get(Context context, String pcUuid, int appId, String appName) {
+        return load(context, pcUuid).settingsFor(appId, appName);
+    }
+
+    /** Zapis; ustawienia puste (wszystko globalne) usuwają aplikację z listy. */
+    public static void save(Context context, String pcUuid, int appId, String appName, AppStreamSettings settings) {
+        String key = HostAppSettings.hostKey(pcUuid);
+        if (key == null) {
+            return;
+        }
+        HostAppSettings updated = load(context, pcUuid).with(appId, appName, settings);
+        SharedPreferences.Editor editor = prefs(context).edit();
+        if (updated.getEntries().isEmpty()) {
+            editor.remove(key);
+        } else {
+            editor.putString(key, updated.encode());
+        }
+        editor.apply();
+    }
+
+    /**
+     * Hak z Game.onCreate (po readPreferences): nakłada ustawienia uruchamianej aplikacji na konfigurację tego
+     * strumienia. Rozdzielczość i FPS trafiają do hosta w żądaniu /launch (pole mode); host zmienia ekran tylko
+     * wtedy, gdy ma to skonfigurowane (docs/host-apps.md).
+     */
+    public static void applyToStream(Context context, PreferenceConfiguration prefConfig, Intent intent) {
+        int appId = intent.getIntExtra(Game.EXTRA_APP_ID, StreamConfiguration.INVALID_APP_ID);
+        if (appId == StreamConfiguration.INVALID_APP_ID) {
+            return;
+        }
+        AppStreamSettings settings = get(context, intent.getStringExtra(Game.EXTRA_PC_UUID), appId,
+                intent.getStringExtra(Game.EXTRA_APP_NAME));
+        if (settings.isEmpty()) {
+            return;
+        }
+        StreamParams global = new StreamParams(prefConfig.width, prefConfig.height, prefConfig.fps);
+        StreamParams stream = AppStreamOverrides.applyStream(global, settings);
+        prefConfig.width = stream.getWidth();
+        prefConfig.height = stream.getHeight();
+        prefConfig.fps = stream.getFps();
+        prefConfig.thumbcastAppProfileFile = settings.getProfileFile();
+        LimeLog.info("Thumbcast: app settings for app " + appId + ": " + global + " -> " + stream
+                + ", profile " + settings.getProfileFile());
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE);
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettingsDialog.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettingsDialog.java
new file mode 100644
index 00000000..805587e3
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/ThumbcastAppSettingsDialog.java
@@ -0,0 +1,209 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK (moduł :app). Dialog „Ustawienia Thumbcast dla aplikacji” z menu kontekstowego aplikacji w AppView:
+// profil sterowania (biblioteka albo domyślny), rozdzielczość i FPS (te same opcje co w ustawieniach upstreamu albo
+// ustawienie globalne). Zapis przez ThumbcastAppSettings; nic nie zmienia ustawień globalnych.
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.util.TypedValue;
+import android.view.View;
+import android.widget.ArrayAdapter;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.Spinner;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.limelight.LimeLog;
+import com.limelight.R;
+import com.limelight.preferences.PreferenceConfiguration;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import app.thumbcast.android.apps.AppStreamSettings;
+import app.thumbcast.android.apps.StreamResolution;
+import app.thumbcast.android.library.ProfileEntry;
+import app.thumbcast.android.library.ProfileRepository;
+
+public final class ThumbcastAppSettingsDialog {
+
+    private ThumbcastAppSettingsDialog() {
+    }
+
+    /** Pozycja listy: etykieta i wartość (null = ustawienie globalne). */
+    private static final class Choice<T> {
+        final String label;
+        final T value;
+
+        Choice(String label, T value) {
+            this.label = label;
+            this.value = value;
+        }
+
+        @Override
+        public String toString() {
+            return label;
+        }
+    }
+
+    public static void show(final Activity activity, final String pcUuid, final int appId, final String appName) {
+        final AppStreamSettings current = ThumbcastAppSettings.get(activity, pcUuid, appId, appName);
+        PreferenceConfiguration global = PreferenceConfiguration.readPreferences(activity);
+
+        // ---- profil ----
+        ProfileRepository repo = ProfileRepository.create(activity);
+        String globalFile = ProfileLibraryActivity.defaultProfileFile(activity);
+        String globalName = globalFile;
+        List<Choice<String>> profiles = new ArrayList<>();
+        int profileIndex = 0;
+        boolean mappedProfileMissing = current.getProfileFile() != null;
+        try {
+            ProfileEntry globalEntry = repo.entry(globalFile);
+            if (globalEntry != null && globalEntry.isValid()) {
+                globalName = globalEntry.getName();
+            }
+            profiles.add(new Choice<String>(activity.getString(R.string.thumbcast_app_settings_default_profile, globalName), null));
+            for (ProfileEntry e : repo.listAll()) {
+                if (!e.isValid()) {
+                    continue;
+                }
+                if (e.getFileName().equals(current.getProfileFile())) {
+                    profileIndex = profiles.size();
+                    mappedProfileMissing = false;
+                }
+                profiles.add(new Choice<>(e.getName(), e.getFileName()));
+            }
+        } catch (RuntimeException e) {
+            LimeLog.warning("Thumbcast: profile list failed: " + e);
+            if (profiles.isEmpty()) {
+                profiles.add(new Choice<String>(activity.getString(R.string.thumbcast_app_settings_default_profile, globalName), null));
+            }
+        }
+
+        // ---- rozdzielczość (wartości jak list_resolution upstreamu) ----
+        String[] resNames = activity.getResources().getStringArray(R.array.resolution_names);
+        String[] resValues = activity.getResources().getStringArray(R.array.resolution_values);
+        List<Choice<StreamResolution>> resolutions = new ArrayList<>();
+        resolutions.add(new Choice<StreamResolution>(activity.getString(R.string.thumbcast_app_settings_global_resolution,
+                global.width + "x" + global.height), null));
+        int resIndex = 0;
+        for (int i = 0; i < Math.min(resNames.length, resValues.length); i++) {
+            StreamResolution r = StreamResolution.parse(resValues[i]);
+            if (r == null) {
+                continue;
+            }
+            if (r.equals(current.getResolution())) {
+                resIndex = resolutions.size();
+            }
+            resolutions.add(new Choice<>(resNames[i] + " (" + r + ")", r));
+        }
+        if (current.getResolution() != null && resIndex == 0) {
+            // Wartość spoza listy (np. zapisana ręcznie): pokazujemy ją, żeby zapis jej nie zgubił.
+            resIndex = resolutions.size();
+            resolutions.add(new Choice<>(current.getResolution().toString(), current.getResolution()));
+        }
+
+        // ---- FPS (wartości jak list_fps upstreamu) ----
+        String[] fpsNames = activity.getResources().getStringArray(R.array.fps_names);
+        String[] fpsValues = activity.getResources().getStringArray(R.array.fps_values);
+        List<Choice<Integer>> fpsChoices = new ArrayList<>();
+        fpsChoices.add(new Choice<Integer>(activity.getString(R.string.thumbcast_app_settings_global_fps, global.fps), null));
+        int fpsIndex = 0;
+        for (int i = 0; i < Math.min(fpsNames.length, fpsValues.length); i++) {
+            int fps;
+            try {
+                fps = Integer.parseInt(fpsValues[i]);
+            } catch (NumberFormatException e) {
+                continue;
+            }
+            if (current.getFps() != null && current.getFps() == fps) {
+                fpsIndex = fpsChoices.size();
+            }
+            fpsChoices.add(new Choice<>(fpsNames[i], fps));
+        }
+        if (current.getFps() != null && fpsIndex == 0) {
+            fpsIndex = fpsChoices.size();
+            fpsChoices.add(new Choice<>(current.getFps() + " FPS", current.getFps()));
+        }
+
+        // ---- widok ----
+        int pad = dp(activity, 20);
+        LinearLayout column = new LinearLayout(activity);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setPadding(pad, pad / 2, pad, 0);
+
+        if (mappedProfileMissing) {
+            addText(activity, column, activity.getString(R.string.thumbcast_app_settings_missing,
+                    current.getProfileFile()), true);
+        }
+        final Spinner profileSpinner = addSpinner(activity, column, R.string.thumbcast_app_settings_profile, profiles, profileIndex);
+        final Spinner resSpinner = addSpinner(activity, column, R.string.thumbcast_app_settings_resolution, resolutions, resIndex);
+        final Spinner fpsSpinner = addSpinner(activity, column, R.string.thumbcast_app_settings_fps, fpsChoices, fpsIndex);
+        addText(activity, column, activity.getString(R.string.thumbcast_app_settings_note), false);
+
+        ScrollView scroll = new ScrollView(activity);
+        scroll.addView(column);
+
+        new AlertDialog.Builder(activity)
+                .setTitle(activity.getString(R.string.thumbcast_app_settings_title, appName))
+                .setView(scroll)
+                .setPositiveButton(R.string.thumbcast_app_settings_save, (d, w) -> {
+                    AppStreamSettings chosen = new AppStreamSettings(
+                            ThumbcastAppSettingsDialog.<String>selected(profileSpinner),
+                            ThumbcastAppSettingsDialog.<StreamResolution>selected(resSpinner),
+                            ThumbcastAppSettingsDialog.<Integer>selected(fpsSpinner));
+                    ThumbcastAppSettings.save(activity, pcUuid, appId, appName, chosen);
+                    Toast.makeText(activity, activity.getString(R.string.thumbcast_app_settings_saved, appName),
+                            Toast.LENGTH_SHORT).show();
+                })
+                .setNeutralButton(R.string.thumbcast_app_settings_reset, (d, w) -> {
+                    ThumbcastAppSettings.save(activity, pcUuid, appId, appName, AppStreamSettings.NONE);
+                    Toast.makeText(activity, activity.getString(R.string.thumbcast_app_settings_cleared, appName),
+                            Toast.LENGTH_SHORT).show();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> T selected(Spinner spinner) {
+        Object item = spinner.getSelectedItem();
+        return item instanceof Choice ? ((Choice<T>) item).value : null;
+    }
+
+    private static <T> Spinner addSpinner(Activity activity, LinearLayout column, int labelRes,
+                                          List<Choice<T>> items, int selection) {
+        TextView label = new TextView(activity);
+        label.setText(labelRes);
+        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        label.setPadding(0, dp(activity, 12), 0, 0);
+        column.addView(label);
+
+        Spinner spinner = new Spinner(activity);
+        ArrayAdapter<Choice<T>> adapter = new ArrayAdapter<>(activity, android.R.layout.simple_spinner_item, items);
+        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
+        spinner.setAdapter(adapter);
+        spinner.setSelection(Math.max(0, Math.min(selection, items.size() - 1)));
+        spinner.setMinimumHeight(dp(activity, 48));
+        column.addView(spinner);
+        return spinner;
+    }
+
+    private static void addText(Activity activity, LinearLayout column, String text, boolean warning) {
+        TextView view = new TextView(activity);
+        view.setText(text);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, warning ? 14 : 12);
+        view.setPadding(0, dp(activity, 12), 0, warning ? 0 : dp(activity, 8));
+        if (!warning) {
+            view.setAlpha(0.75f);
+        }
+        view.setTextAlignment(View.TEXT_ALIGNMENT_VIEW_START);
+        column.addView(view);
+    }
+
+    private static int dp(Activity activity, int value) {
+        return (int) (value * activity.getResources().getDisplayMetrics().density);
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/ThumbcastHostQuit.java b/app/src/main/java/com/limelight/thumbcast/ThumbcastHostQuit.java
