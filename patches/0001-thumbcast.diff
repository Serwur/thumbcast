+    private void refreshGamepadState() {
+        boolean now = isPhysicalGamepadConnected();
+        if (now == gamepadConnected) {
+            return;
+        }
+        gamepadConnected = now;
+        // Podłączenie/odłączenie pada przywraca regułę automatyczną.
+        manualHidden = null;
+        applyControlsHidden();
