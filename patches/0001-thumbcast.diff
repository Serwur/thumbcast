@@ -0,0 +1,49 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK wstawiany do upstreamu moonlight-android (moduł :app).
+// Delegacja 1:1 fasady HostConnection (:control-android) do NvConnection.
+// Sygnatury NvConnection zweryfikowane z upstreamem v12.2 (commit b48494cb96bf): wszystkie sześć
+// metod jest `public void`, bez `throws`, z dokładnie takimi parametrami (short/byte).
+
+import com.limelight.nvstream.NvConnection;
+
+import app.thumbcast.android.host.HostConnection;
+
+public final class HostConnectionImpl implements HostConnection {
+
+    private final NvConnection conn;
+
+    public HostConnectionImpl(NvConnection conn) {
+        this.conn = conn;
+    }
+
+    @Override
+    public void sendKeyboardInput(short keyMap, byte keyDirection, byte modifier, byte flags) {
+        conn.sendKeyboardInput(keyMap, keyDirection, modifier, flags);
+    }
+
+    @Override
+    public void sendMouseMove(short deltaX, short deltaY) {
+        conn.sendMouseMove(deltaX, deltaY);
+    }
+
+    @Override
+    public void sendMousePosition(short x, short y, short referenceWidth, short referenceHeight) {
+        conn.sendMousePosition(x, y, referenceWidth, referenceHeight);
+    }
+
+    @Override
+    public void sendMouseButtonDown(byte mouseButton) {
+        conn.sendMouseButtonDown(mouseButton);
+    }
+
+    @Override
+    public void sendMouseButtonUp(byte mouseButton) {
+        conn.sendMouseButtonUp(mouseButton);
+    }
+
+    @Override
+    public void sendMouseHighResScroll(short scrollAmount) {
+        conn.sendMouseHighResScroll(scrollAmount);
+    }
+}
diff --git a/app/src/main/java/com/limelight/thumbcast/HostPadReporterImpl.java b/app/src/main/java/com/limelight/thumbcast/HostPadReporterImpl.java
new file mode 100644
index 00000000..6711a759
--- /dev/null
+++ b/app/src/main/java/com/limelight/thumbcast/HostPadReporterImpl.java
@@ -0,0 +1,80 @@
+package com.limelight.thumbcast;
+
+// NOWY PLIK wstawiany do upstreamu moonlight-android (moduł :app).
+// Delegacja fasady HostPadReporter (:control-android) do ControllerHandler.reportOscState(...).
+//
+// Retransmisja: zweryfikowane na upstreamie v12.2 (commit b48494cb96bf): powtórka TEGO SAMEGO stanu
+// po 25/50/75 ms (Handler.postDelayed) jest w VirtualController.sendControllerInputContext(), a NIE
+// w ControllerHandler.reportOscState() (ta metoda tylko nadpisuje defaultContext i wysyła pakiet).
+// Komentarz upstreamu: GFE czasem odrzuca pakiety pada, więc zgubiony pakiet zerujący mógłby
+// zostawić zablokowaną gałkę. Nasz overlay nie używa VirtualController, więc powtarzamy ją tutaj:
+// ten sam stan, nigdy nowe naciśnięcie, a każdy nowy stan anuluje zaległe powtórki. To jedyny wyjątek
+// od zasady „zmiana wyjścia tylko z dotyku” dopuszczony przez ActionPolicy (plan 6.2 pkt 1).
+// ControllerHandler.reportOscState jest `public void` i jest wołane z wątku UI (Handler main looper),
+// tak jak w upstreamie.
+
+import android.os.Handler;
+import android.os.Looper;
+
+import com.limelight.binding.input.ControllerHandler;
+
+import app.thumbcast.android.host.HostPadReporter;
+
+public final class HostPadReporterImpl implements HostPadReporter {
+
+    private static final long[] RETRANSMIT_DELAYS_MS = {25, 50, 75};
+
+    private final ControllerHandler controllerHandler;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final boolean retransmit;
+
+    private int buttons;
+    private short lsX, lsY, rsX, rsY;
+    private byte lt, rt;
+
+    private final Runnable resend = new Runnable() {
+        @Override
+        public void run() {
+            send();
+        }
+    };
+
+    public HostPadReporterImpl(ControllerHandler controllerHandler, boolean retransmit) {
+        this.controllerHandler = controllerHandler;
+        this.retransmit = retransmit;
+    }
+
+    public HostPadReporterImpl(ControllerHandler controllerHandler) {
+        this(controllerHandler, true);
+    }
+
+    @Override
+    public void reportOscState(int buttonFlags, short leftStickX, short leftStickY,
+                               short rightStickX, short rightStickY,
+                               byte leftTrigger, byte rightTrigger) {
+        this.buttons = buttonFlags;
+        this.lsX = leftStickX;
+        this.lsY = leftStickY;
+        this.rsX = rightStickX;
+        this.rsY = rightStickY;
+        this.lt = leftTrigger;
+        this.rt = rightTrigger;
+
+        handler.removeCallbacks(resend);
+        send();
+        if (retransmit) {
+            for (long delay : RETRANSMIT_DELAYS_MS) {
+                handler.postDelayed(resend, delay);
+            }
+        }
+    }
+
+    /** Wołać przy zakończeniu sesji (Game.onDestroy / stopConnection). */
+    public void cancelPending() {
+        handler.removeCallbacks(resend);
+    }
+
+    private void send() {
+        controllerHandler.reportOscState(buttons, lsX, lsY, rsX, rsY, lt, rt);
+    }
+}
