+     * „Zakończ sesję” to zamknięcie aplikacji na hoście; zadanie jest oddawane raz.
+     */
+    public Runnable takeAfterStopTask() {
+        Runnable task = pendingHostQuit;
+        pendingHostQuit = null;
+        return task;
+    }
