+        <Button
+            android:id="@+id/thumbcast_profile_edit"
+            style="@style/ThumbcastButton.Text"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:drawableStart="@drawable/thumbcast_ic_edit"
+            android:drawablePadding="@dimen/thumbcast_space_xsmall"
+            android:drawableTint="@color/thumbcast_accent"
+            android:text="@string/thumbcast_lib_action_edit" />
+    </LinearLayout>
