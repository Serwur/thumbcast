diff --git a/app/src/main/res/layout/thumbcast_pc_grid_item.xml b/app/src/main/res/layout/thumbcast_pc_grid_item.xml
new file mode 100644
index 00000000..939ef5f5
--- /dev/null
+++ b/app/src/main/res/layout/thumbcast_pc_grid_item.xml
@@ -0,0 +1,100 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    THUMBCAST (P2, U9): karta PC zamiast pc_grid_item.xml (PcGridAdapter, blok THUMBCAST; wypełnia ThumbcastLauncherUi).
+    Identyfikatory GenericGridAdapter zostają: grid_image, grid_overlay, grid_text, grid_spinner.
+    Stan: plakietka tekstowa (kolor tylko jako drugi sygnał) i ikona przy komputerze. Przycisk ⋮ otwiera to samo menu
+    co długie przytrzymanie; nie bierze fokusu, żeby siatka dalej obsługiwała tap i pad.
+    Karta nie jest klikalna sama: tap i przytrzymanie obsługuje GridView (setPressed uruchamia falę tła).
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:background="@drawable/thumbcast_bg_card_selectable"
+    android:orientation="vertical"
+    android:paddingStart="@dimen/thumbcast_space_medium"
+    android:paddingEnd="@dimen/thumbcast_space_xsmall"
+    android:paddingTop="@dimen/thumbcast_space_xsmall"
+    android:paddingBottom="@dimen/thumbcast_space_medium">
+
+    <RelativeLayout
+        android:layout_width="match_parent"
+        android:layout_height="@dimen/thumbcast_touch_target">
+
+        <FrameLayout
+            android:layout_width="44dp"
+            android:layout_height="40dp"
+            android:layout_alignParentStart="true"
+            android:layout_alignParentBottom="true"
+            android:importantForAccessibility="noHideDescendants">
+
+            <ImageView
+                android:id="@+id/grid_image"
+                android:layout_width="36dp"
+                android:layout_height="36dp"
+                android:layout_gravity="start|top"
+                android:importantForAccessibility="no"
+                android:scaleType="fitCenter"
+                android:tint="@color/thumbcast_text" />
+
+            <ImageView
+                android:id="@+id/grid_overlay"
+                android:layout_width="@dimen/thumbcast_icon_size_small"
+                android:layout_height="@dimen/thumbcast_icon_size_small"
+                android:layout_gravity="end|bottom"
+                android:importantForAccessibility="no"
+                android:scaleType="fitCenter"
+                android:visibility="gone" />
+        </FrameLayout>
+
+        <ImageButton
+            android:id="@+id/thumbcast_pc_more"
+            style="@style/ThumbcastIconButton"
+            android:layout_alignParentEnd="true"
+            android:layout_alignParentTop="true"
+            android:contentDescription="@string/thumbcast_common_more_options"
+            android:focusable="false"
+            android:focusableInTouchMode="false"
+            android:src="@drawable/thumbcast_ic_more_vert"
+            android:tint="@color/thumbcast_text_secondary" />
+    </RelativeLayout>
+
+    <TextView
+        android:id="@+id/grid_text"
+        style="@style/ThumbcastText.ListTitle"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/thumbcast_space_small"
+        android:paddingStart="0dp"
+        android:paddingEnd="@dimen/thumbcast_space_medium"
+        android:ellipsize="end"
+        android:fontFamily="sans-serif-medium"
+        android:maxLines="2"
+        android:minLines="2" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="@dimen/thumbcast_space_small"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="0dp"
+        android:paddingEnd="@dimen/thumbcast_space_medium">
+
+        <ProgressBar
+            android:id="@+id/grid_spinner"
+            android:layout_width="@dimen/thumbcast_icon_size_small"
+            android:layout_height="@dimen/thumbcast_icon_size_small"
+            android:layout_marginEnd="@dimen/thumbcast_space_small"
+            android:importantForAccessibility="no"
+            android:indeterminate="true"
+            android:indeterminateTint="@color/thumbcast_text_secondary"
+            android:visibility="gone" />
+
+        <TextView
+            android:id="@+id/thumbcast_pc_status"
+            style="@style/ThumbcastText.Badge.Neutral"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:ellipsize="end" />
+    </LinearLayout>
+</LinearLayout>
