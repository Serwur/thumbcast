{
  "schema": 1,
  "id": "4f9b2d7a-1c3e-4b8f-9e20-6a7d5c4b3a02",
  "name": "MMO – Klawiatura",
  "tags": { "game": "mmo-generic", "preset": "mmo-keyboard" },
  "mode": "keyboard_mouse",
  "reference": { "aspect": "20:9", "unit": "dp-normalized" },
  "handedness": "right",
  "global": {
    "opacity": 0.55,
    "haptics": { "enabled": true, "strength": 0.6, "onPress": "tick", "onRelease": "none" },
    "slideToPress": false,
    "autoHideOnGamepad": true,
    "allowChords": false
  },
  "gestures": {
    "cameraDrag": { "zone": "right_free", "output": "mouse_look",
                    "sensitivity": 1.0, "curve": { "type": "linear" },
                    "deadzonePx": 4, "invertY": false, "maxDeflection": 1.0, "decayMs": 0 },
    "tapTarget":  { "enabled": true, "output": "mouse_left_at_point", "maxMovePx": 12, "maxMs": 220 },
    "longPress":  { "enabled": true, "output": "mouse_right_at_point", "minMs": 450 },
    "pinchZoom":  { "enabled": true, "output": "mouse_wheel", "pxPerNotch": 40 },
    "edgeSwipeTop": { "enabled": true, "output": "app_menu" }
  },
  "controls": [
    { "id": "move", "type": "stick", "label": "Ruch", "output": { "pad": "left_stick" },
      "rect": { "x": 0.0, "y": 0.49, "w": 0.2975, "h": 0.51 }, "floating": true,
      "deadzone": 0.12, "outerDeadzone": 0.04, "curve": { "type": "linear" },
      "kbmKeys": { "up": "W", "down": "S", "left": "A", "right": "D" },
      "kbmThreshold": 0.35, "sprintLock": true },

    { "id": "strafe_left", "type": "button", "label": "Krok w lewo", "output": { "key": "Q" },
      "rect": { "x": 0.0298, "y": 0.2176, "w": 0.0765, "h": 0.0918 }, "shape": "rounded_rect" },
    { "id": "strafe_right", "type": "button", "label": "Krok w prawo", "output": { "key": "E" },
      "rect": { "x": 0.1318, "y": 0.2176, "w": 0.0765, "h": 0.0918 }, "shape": "rounded_rect" },

